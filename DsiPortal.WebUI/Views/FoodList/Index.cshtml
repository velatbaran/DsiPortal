
@model IEnumerable<FoodList>

@{
    ViewData["Title"] = "Yemek Listesi";
}

<link rel="stylesheet" href="~/css/foodlist.css" />

<div class="foodlist-page">

    <!-- HEADER -->

    <div class="foodlist-header">

        <div class="foodlist-header-left">

            <div class="foodlist-header-icon">

                <i class="fa-solid fa-utensils"></i>

            </div>

            <div class="foodlist-header-text">

                <h2>Yemek Listesi</h2>

                <p>
                    Kurum yemek listelerini yönetin ve yayınlayın.
                </p>

            </div>

        </div>


        <a asp-action="Create"
           class="btn btn-success foodlist-add-button"
           title="Yeni Yemek Listesi Ekle">

            <i class="fa-solid fa-plus"></i>

            Yeni Yemek Listesi

        </a>

    </div>


    <!-- MESAJ -->
    @if (!string.IsNullOrWhiteSpace(ViewBag.Mesaj))
    {
        <div class="foodlist-message">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @ViewBag.Mesaj
            </span>

        </div>
    }


    <!-- TABLO -->
    @if (Model != null && Model.Any())
    {
        <div class="foodlist-table-card">

            <div class="foodlist-table-wrapper">

                <table class="foodlist-table">

                    <thead>

                        <tr>

                            <th>Dosya</th>

                            <th>Tür</th>

                            <th>Kaydeden</th>

                            <th>Kayıt Tarihi</th>

                            <th class="text-end">İşlemler</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            string fileIcon = "fa-file";
                            string fileClass = "other";

                            if (item.FileType == ".pdf")
                            {
                                fileIcon = "fa-file-pdf";
                                fileClass = "pdf";
                            }
                            else if (
                            item.FileType == ".doc" ||
                            item.FileType == ".docx")
                            {
                                fileIcon = "fa-file-word";
                                fileClass = "word";
                            }
                            else if (
                            item.FileType == ".xls" ||
                            item.FileType == ".xlsx")
                            {
                                fileIcon = "fa-file-excel";
                                fileClass = "excel";
                            }


                            <tr>

                                <!-- DOSYA -->

                                <td data-label="Dosya">

                                    <div class="foodlist-file">

                                        <div class="foodlist-file-icon @fileClass">

                                            <i class="fa-regular @fileIcon"></i>

                                        </div>


                                        <div class="foodlist-file-info">

                                            <span class="foodlist-file-name"
                                                  title="@item.Name">

                                                @item.Name

                                            </span>

                                            <span class="foodlist-file-type">

                                                @item.FileType

                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- TÜR -->

                                <td data-label="Tür">

                                    <span class="foodlist-type">

                                        <i class="fa-regular @fileIcon"></i>

                                        @item.FileType.ToUpper()

                                    </span>

                                </td>


                                <!-- KAYDEDEN -->

                                <td data-label="Kaydeden">

                                    <div class="foodlist-meta">

                                        <div class="foodlist-meta-icon">

                                            <i class="fa-solid fa-user"></i>

                                        </div>

                                        <span class="foodlist-meta-text">

                                            @item.Created

                                        </span>

                                    </div>

                                </td>


                                <!-- TARİH -->

                                <td data-label="Kayıt Tarihi">

                                    <div class="foodlist-meta">

                                        <div class="foodlist-meta-icon">

                                            <i class="fa-regular fa-calendar"></i>

                                        </div>

                                        <span class="foodlist-meta-text">

                                            @item.CreatedDate

                                        </span>

                                    </div>

                                </td>


                                <!-- İŞLEMLER -->

                                <td data-label="İşlemler">

                                    <div class="foodlist-actions">


                                        <!-- MAIL -->

                                        <form method="post"
                                              enctype="multipart/form-data"
                                              asp-action="SendEposta"
                                              class="foodlist-mail-form">

                                            <button type="submit"
                                                    class="btn btn-outline-success foodlist-action foodlist-mail-button"
                                                    title="Mail Gönder">

                                                <i class="fa-solid fa-paper-plane"></i>

                                                <span>Mail Gönder</span>

                                            </button>

                                        </form>


                                        <!-- İNDİR -->

                                        <a asp-action="Download"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary foodlist-action"
                                           title="İndir">

                                            <i class="fa-solid fa-download"></i>

                                            <span>İndir</span>

                                        </a>


                                        <!-- GÖRÜNTÜLE -->
                                        @if (item.FileType == ".pdf")
                                        {
                                            <a href="@Url.Action("ViewPdf", "FoodList", new { id = item.Id })"
                                               target="_blank"
                                               class="btn btn-outline-info foodlist-action"
                                               title="Görüntüle">

                                                <i class="fa-solid fa-eye"></i>

                                                <span>Görüntüle</span>

                                            </a>
                                        }


                                        <!-- SİL -->

                                        <button type="button"
                                                class="btn btn-outline-danger foodlist-action"
                                                data-bs-toggle="modal"
                                                data-bs-target="#foodlistDeleteModal"
                                                data-file-id="@item.Id"
                                                data-file-name="@item.Name"
                                                title="Sil">

                                            <i class="fa-solid fa-trash"></i>

                                            <span>Sil</span>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="foodlist-table-card">

            <div class="foodlist-empty">

                <div class="foodlist-empty-icon">

                    <i class="fa-solid fa-utensils"></i>

                </div>

                <h5>
                    Henüz yemek listesi bulunmuyor
                </h5>

                <p>
                    Sisteme henüz bir yemek listesi eklenmemiş.
                </p>

                <a asp-action="Create"
                   class="btn btn-success rounded-pill px-4">

                    <i class="fa-solid fa-plus me-1"></i>

                    Yemek Listesi Ekle

                </a>

            </div>

        </div>
    }

</div>


<!-- =====================================================
     DELETE MODAL
     ===================================================== -->

<div class="modal fade foodlist-modal"
     id="foodlistDeleteModal"
     tabindex="-1"
     aria-labelledby="foodlistDeleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  asp-action="Delete">

                <div class="modal-body text-center p-4">

                    <div class="foodlist-delete-icon">

                        <i class="fa-solid fa-trash"></i>

                    </div>

                    <h5 class="fw-bold mb-2">

                        Yemek Listesini Sil

                    </h5>

                    <p class="text-muted mb-0">

                        <span id="foodlistFileName"
                              class="foodlist-delete-name">
                        </span>

                        adlı dosya silinecek.

                    </p>


                    <input type="hidden"
                           name="id"
                           id="foodlistFileId" />

                </div>


                <div class="modal-footer border-0 justify-content-center pb-4">

                    <button type="button"
                            class="btn btn-light rounded-pill px-4"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark me-1"></i>

                        Vazgeç

                    </button>


                    <button type="submit"
                            class="btn btn-danger rounded-pill px-4">

                        <i class="fa-solid fa-trash me-1"></i>

                        Listeyi Sil

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        /* =====================================================
           SİLME MODALI
           ===================================================== */

        const foodlistDeleteModal =
            document.getElementById(
                'foodlistDeleteModal'
            );


        foodlistDeleteModal.addEventListener(
            'show.bs.modal',
            function (event) {

                const button =
                    event.relatedTarget;


                const fileId =
                    button.getAttribute(
                        'data-file-id'
                    );


                const fileName =
                    button.getAttribute(
                        'data-file-name'
                    );


                document.getElementById(
                    'foodlistFileId'
                ).value = fileId;


                document.getElementById(
                    'foodlistFileName'
                ).textContent = fileName;

            }
        );


        /* =====================================================
           MAIL GÖNDER
           Her satırın kendi butonunu kontrol eder.
           ===================================================== */

        document
            .querySelectorAll(
                '.foodlist-mail-form'
            )
            .forEach(function (form) {

                form.addEventListener(
                    'submit',
                    function () {

                        const button =
                            form.querySelector(
                                '.foodlist-mail-button'
                            );


                        if (!button)
                            return;


                        button.disabled = true;

                        button.classList.add(
                            'loading'
                        );


                        button.innerHTML =
                            '<i class="fa-solid fa-spinner fa-spin"></i>' +
                            '<span>Gönderiliyor...</span>';

                    }
                );

            });

    </script>

}

