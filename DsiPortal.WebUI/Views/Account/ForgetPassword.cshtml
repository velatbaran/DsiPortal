@model ForgetPasswordViewModel

@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_LayoutLogin";
}

<link href="~/css/forgetpassword-theme.css" rel="stylesheet" />
<div class="row justify-content-center align-items-center min-vh-100 py-4">
    <div class="col-xl-10 col-lg-12 col-md-9">
        <div class="card card-login-custom my-5">
            <div class="card-body p-0">
                <div class="row g-0">
                    <!-- Görsel Alanı (Büyük ekranlarda görünür) -->
                    <div class="col-lg-6 d-none d-lg-block">
                        <div class="login-bg-container">
                            <img src="~/admin/img/dsi24login.jpg" class="login-bg-img" alt="DSİ 24. Bölge Görseli" />
                        </div>
                    </div>

                    <!-- Form Alanı -->
                    <div class="col-lg-6">
                        <div class="p-4 p-sm-5">
                            <div class="text-center mb-4">
                                <div class="mb-3">
                                    <i class="fa-solid fa-shield-halved fa-3x" style="color: #082741;"></i>
                                </div>
                                <h4 class="font-weight-bold text-gray-900 mb-1">DSİ 24. Bölge Müdürlüğü</h4>
                                <p class="text-muted small">Yeni Şifre Oluşturma Paneli</p>
                            </div>

                            <!-- Bilgilendirme Notu -->
                            <div class="info-box-warning mb-4">
                                <i class="fa-solid fa-circle-info me-1 text-warning"></i>
                                Lütfen sistemde kayıtlı olan <strong>kullanıcı adınızı</strong> ve belirlemek istediğiniz yeni şifrenizi giriniz.
                            </div>

                            <form class="user" asp-action="ForgetPassword">
                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                                <!-- Kullanıcı Adı -->
                                <div class="form-group mb-3">
                                    <label asp-for="Username" class="form-label small font-weight-bold text-gray-700">Kullanıcı Adı</label>
                                    <div class="input-group">
                                        <span class="input-group-text input-group-text-custom">
                                            <i class="fa-solid fa-user"></i>
                                        </span>
                                        <input asp-for="Username" class="form-control form-control-custom" placeholder="Kullanıcı adınız..." />
                                    </div>
                                    <span asp-validation-for="Username" class="text-danger small"></span>
                                </div>

                                <!-- Yeni Şifre -->
                                <div class="form-group mb-3">
                                    <label asp-for="Password" class="form-label small font-weight-bold text-gray-700">Yeni Şifre</label>
                                    <div class="input-group">
                                        <span class="input-group-text input-group-text-custom">
                                            <i class="fa-solid fa-lock"></i>
                                        </span>
                                        <input type="password" asp-for="Password" class="form-control form-control-custom" placeholder="Yeni şifreniz..." />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <!-- Şifre Tekrarı -->
                                <div class="form-group mb-4">
                                    <label asp-for="RePassword" class="form-label small font-weight-bold text-gray-700">Yeni Şifre (Tekrar)</label>
                                    <div class="input-group">
                                        <span class="input-group-text input-group-text-custom">
                                            <i class="fa-solid fa-key"></i>
                                        </span>
                                        <input type="password" asp-for="RePassword" class="form-control form-control-custom" placeholder="Yeni şifrenizi tekrar giriniz..." />
                                    </div>
                                    <span asp-validation-for="RePassword" class="text-danger small"></span>
                                </div>

                                <!-- Butonlar -->
                                <div class="row g-2">
                                    <div class="col-sm-6 mb-2 mb-sm-0">
                                        <button type="submit" class="btn btn-dsi-warning w-100">
                                            <i class="fa-solid fa-rotate me-1"></i> Şifreyi Güncelle
                                        </button>
                                    </div>
                                    <div class="col-sm-6">
                                        <a class="btn btn-dsi-outline w-100 text-center d-block" href="/Account/Login">
                                            <i class="fa-solid fa-arrow-left me-1"></i> Giriş Yap
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>