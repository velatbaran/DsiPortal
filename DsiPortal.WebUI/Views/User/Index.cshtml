@using NToastNotify
@model IEnumerable<Users>

@{
    ViewData["Title"] = "Kullanıcılar";
}

<link href="~/css/users.css" rel="stylesheet" />

<div class="users-page">

    <!-- Sayfa Başlığı -->
    <div class="users-page-header">
        <div class="users-title-area">
            <div class="users-title-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div>
                <h2>Kullanıcılar</h2>
                <p>Sistemde kayıtlı kullanıcıları yönetin.</p>
            </div>
        </div>

        <a asp-action="Create" class="users-add-btn">
            <i class="fa-solid fa-plus"></i>
            <span>Yeni Kullanıcı Ekle</span>
        </a>
    </div>


    <!-- Kullanıcı Kartı -->
    <div class="users-card">

        <div class="users-card-header">
            <div>
                <h5>
                    <i class="fa-solid fa-user-shield"></i>
                    Kullanıcı Listesi
                </h5>
                <span>
                    Sistemde kayıtlı kullanıcılar
                </span>
            </div>

            <div class="users-count">
                <i class="fa-solid fa-users"></i>
                @Model.Count() Kullanıcı
            </div>
        </div>


        <div class="users-table-wrapper">

            <table class="users-table">

                <thead>
                    <tr>
                        <th>Adı</th>
                        <th>Soyadı</th>
                        <th>Kullanıcı Adı</th>
                        <th>Şifre</th>
                        <th>Yetki</th>
                        <th>Durum</th>
                        <th>Kaydeden</th>
                        <th>Kayıt Tarihi</th>
                        <th class="users-actions-column">İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <div class="users-person">
                                    <div class="users-avatar">
                                        @item.Name?.Substring(0, 1).ToUpper()
                                    </div>

                                    <span>@item.Name</span>
                                </div>
                            </td>

                            <td>
                                <span class="users-surname">
                                    @item.Surname
                                </span>
                            </td>

                            <td>
                                <span class="users-username">
                                    <i class="fa-solid fa-at"></i>
                                    @item.Username
                                </span>
                            </td>

                            <td>
                                <span class="users-password">
                                    ••••••••
                                </span>
                            </td>

                            <td>

                                @if (item.IsAdmin)
                                {
                                    <span class="users-badge users-badge-admin">
                                        <i class="fa-solid fa-shield-halved"></i>
                                        Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="users-badge users-badge-user">
                                        <i class="fa-solid fa-user"></i>
                                        Standart
                                    </span>
                                }

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="users-badge users-badge-active">
                                        <span class="users-status-dot"></span>
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="users-badge users-badge-passive">
                                        <span class="users-status-dot"></span>
                                        Pasif
                                    </span>
                                }

                            </td>

                            <td>
                                <span class="users-created">
                                    <i class="fa-solid fa-user-pen"></i>
                                    @item.Created
                                </span>
                            </td>

                            <td>
                                <span class="users-date">
                                    @item.CreatedDate
                                </span>
                            </td>

                            <td>

                                <div class="users-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="users-action-btn users-edit-btn"
                                       title="Kullanıcıyı Güncelle">

                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <button type="button"
                                            class="users-action-btn users-delete-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-file-id="@item.Id"
                                            data-file-name="@item.Name @item.Surname"
                                            title="Kullanıcıyı Sil">

                                        <i class="fa-solid fa-trash"></i>
                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- Silme Modal -->
<div class="modal fade users-delete-modal"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post" asp-action="Delete">

                <div class="users-modal-header">

                    <div class="users-modal-icon">
                        <i class="fa-solid fa-trash"></i>
                    </div>

                    <div>
                        <h5 id="deleteModalLabel">
                            Kullanıcıyı Sil
                        </h5>

                        <span>
                            Bu işlem geri alınamaz.
                        </span>
                    </div>

                    <button type="button"
                            class="users-modal-close"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark"></i>

                    </button>

                </div>


                <div class="users-modal-body">

                    <div class="users-delete-warning">

                        <i class="fa-solid fa-triangle-exclamation"></i>

                        <div>
                            <strong id="fileName"></strong>
                            <p>
                                isimli kullanıcıyı silmek istediğinize emin misiniz?
                            </p>
                        </div>

                    </div>

                    <input type="hidden"
                           name="id"
                           id="fileId" />

                </div>


                <div class="users-modal-footer">

                    <button type="button"
                            class="users-modal-cancel"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark"></i>
                        Vazgeç

                    </button>

                    <button type="submit"
                            class="users-modal-delete">

                        <i class="fa-solid fa-trash"></i>
                        Kullanıcıyı Sil

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {

            const button = event.relatedTarget;

            const fileId = button.getAttribute('data-file-id');
            const fileName = button.getAttribute('data-file-name');

            document.getElementById('fileId').value = fileId;
            document.getElementById('fileName').textContent = fileName;

        });

    </script>

}