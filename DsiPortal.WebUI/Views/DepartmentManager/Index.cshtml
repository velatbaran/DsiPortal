@model IEnumerable<DepartmentManagers>

@{
    ViewData["Title"] = "Müdürler";
}

<style>
    :root {
        --wc-primary: #4f46e5;
        --wc-primary-light: #eef2ff;
        --wc-radius: 14px;
        --wc-shadow: 0 4px 16px rgba(15, 23, 42, .06);
    }

    .wc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .wc-title {
        font-weight: 700;
        font-size: 1.5rem;
        color: #1e1b4b;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .wc-title .badge {
            font-size: .75rem;
            background: var(--wc-primary-light);
            color: var(--wc-primary);
            font-weight: 600;
        }

    .btn-wc-primary {
        background: var(--wc-primary);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: .55rem 1.1rem;
        font-weight: 600;
        transition: all .2s ease;
        box-shadow: 0 2px 8px rgba(79, 70, 229, .25);
    }

        .btn-wc-primary:hover {
            background: #4338ca;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(79, 70, 229, .35);
        }

    .wc-card {
        background: #fff;
        border-radius: var(--wc-radius);
        box-shadow: var(--wc-shadow);
        border: 1px solid #eef0f4;
        overflow: hidden;
    }

    .wc-toolbar {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #f0f1f5;
        background: #fafbff;
    }

    .wc-search-wrap .input-group-text {
        background: #fff;
        border-right: none;
        color: #94a3b8;
    }

    .wc-search-wrap input {
        border-left: none;
    }

        .wc-search-wrap input:focus {
            box-shadow: none;
            border-color: #dfe3ea;
        }

    table.wc-table {
        margin-bottom: 0;
    }

        table.wc-table thead th {
            background: #f8f9fc;
            color: #64748b;
            font-size: .8rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-weight: 700;
            border-bottom: 1px solid #eef0f4;
            padding: .9rem 1rem;
            white-space: nowrap;
        }

        table.wc-table tbody tr.wc-row {
            transition: background .15s ease;
        }

            table.wc-table tbody tr.wc-row:hover {
                background: #f9fafe;
            }

        table.wc-table tbody td {
            padding: .85rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f2f3f7;
        }

    .wc-person {
        display: flex;
        align-items: center;
        gap: .7rem;
    }

    .wc-avatar {
        width: 42px;
        height: 42px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #eef0f4;
        flex-shrink: 0;
    }

    .wc-name {
        font-weight: 600;
        color: #1e293b;
    }

    .wc-title-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .3rem .65rem;
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 600;
        background: #fff7ed;
        color: #c2410c;
    }

    .wc-contact {
        display: flex;
        flex-direction: column;
        gap: .15rem;
        font-size: .85rem;
        color: #475569;
    }

        .wc-contact a {
            color: #475569;
            text-decoration: none;
        }

            .wc-contact a:hover {
                color: var(--wc-primary);
            }

    .wc-actions {
        display: flex;
        gap: .4rem;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .btn-action {
        border-radius: 9px;
        font-weight: 600;
        font-size: .8rem;
        padding: .4rem .7rem;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        transition: all .15s ease;
    }

        .btn-action.btn-edit {
            background: #fff7ed;
            color: #c2410c;
        }

            .btn-action.btn-edit:hover {
                background: #c2410c;
                color: #fff;
            }

    .btn-icon-sm {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        border: 1px solid #f1d3d3;
        background: #fff5f5;
        color: #e11d48;
        transition: all .15s ease;
        flex-shrink: 0;
    }

        .btn-icon-sm:hover {
            background: #e11d48;
            color: #fff;
        }

    .wc-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: #94a3b8;
    }

    #deleteModal .modal-content {
        border: none;
        border-radius: 16px;
        overflow: hidden;
    }

    #deleteModal .modal-header {
        background: #fff5f5;
        border-bottom: none;
    }

    #deleteModal .modal-title {
        color: #be123c;
        font-weight: 700;
    }
</style>

<div class="wc-header">
    <div class="wc-title">
        <i class="fa-solid fa-user-tie" style="color:var(--wc-primary)"></i>
        Müdürler
        <span class="badge">@Model.Count() kişi</span>
    </div>
    <a asp-action="Create" class="btn btn-wc-primary" title="Yeni Müdür Ekle">
        <i class="fa-solid fa-plus"></i> Yeni Müdür Ekle
    </a>
</div>

<div class="wc-card">
    <div class="wc-toolbar">
        <div class="input-group wc-search-wrap" style="max-width: 340px;">
            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="wcSearch" class="form-control" placeholder="İsim veya unvana göre ara...">
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="wc-empty">
            <i class="fa-solid fa-user-slash fa-2x mb-2"></i>
            <div>Henüz kayıt bulunmuyor.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table wc-table" id="myTable">
                <thead>
                    <tr>
                        <th>Adı</th>
                        <th>Unvan</th>
                        <th>İletişim</th>
                        <th>Kaydeden</th>
                        <th>Kayıt Tarihi</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="wc-row" data-search="@item.Name.ToLower() @item.Titles.Name.ToLower()">
                            <td>
                                <div class="wc-person">
                                    <img src="@Url.Action("ViewImage", new { id = item.Id })" class="wc-avatar" alt="@item.Name">
                                    <span class="wc-name">@item.Name</span>
                                </div>
                            </td>
                            <td>
                                <span class="wc-title-badge">
                                    <i class="fa-solid fa-id-badge"></i> @item.Titles.Name
                                </span>
                            </td>
                            <td>
                                <div class="wc-contact">
                                    <a href="mailto:@item.Eposta"><i class="fa-regular fa-envelope me-1"></i>@item.Eposta</a>
                                    <a href="tel:@item.Phone"><i class="fa-solid fa-phone me-1"></i>@item.Phone</a>
                                </div>
                            </td>
                            <td>@item.Created</td>
                            <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="wc-actions">
                                    <a href="/DepartmentManager/Edit/@item.Id" class="btn-action btn-edit" title="Güncelle">
                                        <i class="fa-solid fa-pen-to-square"></i> Güncelle
                                    </a>
                                    <button type="button" class="btn-icon-sm" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-file-id="@item.Id" data-file-name="@item.Name" title="Sil">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="Delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel"><i class="fa-solid fa-triangle-exclamation me-2"></i>Silme Onayı</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <strong id="fileName"></strong> kaydını silmek istediğinize emin misiniz?
                    <input type="hidden" name="id" id="fileId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa-solid fa-xmark"></i> İptal</button>
                    <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const deleteModal = document.getElementById('deleteModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const fileId = button.getAttribute('data-file-id');
        const fileName = button.getAttribute('data-file-name');
        document.getElementById('fileId').value = fileId;
        document.getElementById('fileName').textContent = fileName;
    });

    document.addEventListener('DOMContentLoaded', function () {
        var searchInput = document.getElementById('wcSearch');
        if (searchInput) {
            searchInput.addEventListener('keyup', function () {
                var term = this.value.trim().toLowerCase();
                document.querySelectorAll('#myTable tbody tr.wc-row').forEach(function (row) {
                    var haystack = row.getAttribute('data-search') || '';
                    row.style.display = haystack.includes(term) ? '' : 'none';
                });
            });
        }
    });
</script>
