@model DepartmentManagerEditViewModel
@{
    ViewData["Title"] = "Müdür Ekle";
}

<style>
    :root {
        --wc-primary: #4f46e5;
        --wc-primary-light: #eef2ff;
        --wc-radius: 14px;
        --wc-shadow: 0 4px 16px rgba(15, 23, 42, .06);
    }

    .wc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .wc-title {
        font-weight: 700;
        font-size: 1.5rem;
        color: #1e1b4b;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .wc-back-link {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        color: #64748b;
        font-weight: 600;
        font-size: .9rem;
        text-decoration: none;
        transition: color .15s ease;
    }

        .wc-back-link:hover {
            color: var(--wc-primary);
        }

    .wc-card {
        background: #fff;
        border-radius: var(--wc-radius);
        box-shadow: var(--wc-shadow);
        border: 1px solid #eef0f4;
        padding: 1.75rem;
        max-width: 640px;
    }

    .wc-form-group {
        margin-bottom: 1.3rem;
    }

        .wc-form-group label {
            display: block;
            font-weight: 600;
            font-size: .85rem;
            color: #334155;
            margin-bottom: .45rem;
        }

        .wc-form-group .form-control,
        .wc-form-group select.form-control {
            border: 1px solid #e2e5eb;
            border-radius: 10px;
            padding: .6rem .85rem;
            font-size: .92rem;
            transition: all .15s ease;
        }

            .wc-form-group .form-control:focus {
                border-color: var(--wc-primary);
                box-shadow: 0 0 0 3px var(--wc-primary-light);
                outline: none;
            }

    .wc-image-picker {
        display: flex;
        align-items: center;
        gap: 1.1rem;
    }

    .wc-avatar-preview {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        border: 2px dashed #dfe3ea;
        background: #f8f9fc;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #b8bfcc;
        font-size: 1.3rem;
        overflow: hidden;
        flex-shrink: 0;
    }

        .wc-avatar-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .wc-file-drop {
        flex: 1;
        position: relative;
    }

        .wc-file-drop input[type="file"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
            width: 100%;
            height: 100%;
        }

    .wc-file-drop-label {
        display: flex;
        align-items: center;
        gap: .5rem;
        border: 1px dashed #dfe3ea;
        border-radius: 10px;
        padding: .65rem .9rem;
        font-size: .85rem;
        color: #64748b;
        background: #fafbff;
        transition: all .15s ease;
    }

        .wc-file-drop-label i {
            color: var(--wc-primary);
        }

    .wc-file-drop:hover .wc-file-drop-label {
        border-color: var(--wc-primary);
        background: var(--wc-primary-light);
        color: var(--wc-primary);
    }

    .wc-btn-save {
        background: var(--wc-primary);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: .6rem 1.4rem;
        font-weight: 600;
        transition: all .2s ease;
        box-shadow: 0 2px 8px rgba(79, 70, 229, .25);
    }

        .wc-btn-save:hover {
            background: #4338ca;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(79, 70, 229, .35);
        }

    .text-danger {
        font-size: .8rem;
    }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 1.1rem;
    }
</style>

<div class="wc-header">
    <div class="wc-title">
        <i class="fa-solid fa-user-plus" style="color:var(--wc-primary)"></i>
        Müdür Ekle
    </div>
    <a asp-action="Index" class="wc-back-link">
        <i class="fa-solid fa-arrow-left"></i> Geri Dön
    </a>
</div>

<div class="wc-card">
    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id"/>

        <div class="wc-form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" placeholder="Ad soyad giriniz" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="wc-form-group">
            <label asp-for="TitleId"></label>
            <select asp-for="TitleId" class="form-control" asp-items="ViewBag.TitleId"></select>
            <span asp-validation-for="TitleId" class="text-danger"></span>
        </div>

        <div class="wc-form-group">
            <label asp-for="Eposta"></label>
            <input asp-for="Eposta" class="form-control" placeholder="ornek@sirket.com" />
            <span asp-validation-for="Eposta" class="text-danger"></span>
        </div>

        <div class="wc-form-group">
            <label>Telefon</label>
            <input asp-for="Phone" class="form-control" placeholder="0(5xx) xxx xx xx" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="wc-form-group">
            <label asp-for="Image"></label>
            <div class="wc-image-picker">
                <div class="wc-avatar-preview" id="avatarPreview">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div class="wc-file-drop">
                    <input asp-for="Image" id="customFile" accept="image/*">
                    <div class="wc-file-drop-label" id="fileLabel">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        <span id="fileLabelText">Resim seçiniz</span>
                    </div>
                </div>
            </div>
            <span asp-validation-for="Image" class="text-danger"></span>
        </div>

        <div class="wc-form-group mb-0">
            <button type="submit" class="btn wc-btn-save" title="Kaydet">
                <i class="fa-solid fa-floppy-disk"></i> Kaydet
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('customFile').addEventListener('change', function () {
            var file = this.files && this.files[0];
            var labelText = document.getElementById('fileLabelText');
            var preview = document.getElementById('avatarPreview');

            if (file) {
                labelText.textContent = file.name;

                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.innerHTML = '<img src="' + e.target.result + '" alt="Önizleme">';
                };
                reader.readAsDataURL(file);
            } else {
                labelText.textContent = 'Resim seçiniz';
                preview.innerHTML = '<i class="fa-solid fa-user"></i>';
            }
        });
    </script>
}
