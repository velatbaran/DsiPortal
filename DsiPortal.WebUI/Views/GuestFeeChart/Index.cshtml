@model IEnumerable<GuestFeeChart>

@{
    ViewData["Title"] = "Misafirhane Yemek Çizelgesi";
}

<link rel="stylesheet" href="~/css/guest-fee-chart.css" asp-append-version="true" />

<div class="gfc-page">

    <!-- Üst Başlık -->
    <div class="gfc-header">

        <div class="gfc-title-area">
            <div class="gfc-title-icon">
                <i class="fa-solid fa-utensils"></i>
            </div>

            <div>
                <h2>Misafirhane Yemek Çizelgesi</h2>
                <p>Misafirhane yemek çizelgelerini buradan yönetebilirsiniz.</p>
            </div>
        </div>

        <a asp-action="Create" class="gfc-add-btn">
            <i class="fa-solid fa-plus"></i>
            <span>Yeni Çizelge Ekle</span>
        </a>

    </div>


    <!-- Bilgi Kartı -->
    <div class="gfc-info-bar">

        <div class="gfc-info-left">
            <div class="gfc-info-icon">
                <i class="fa-solid fa-file-lines"></i>
            </div>

            <div>
                <strong>Çizelgeler</strong>
                <span>Yüklenen yemek çizelgeleri</span>
            </div>
        </div>

        <div class="gfc-count">
            <strong>@Model.Count()</strong>
            <span>Kayıt</span>
        </div>

    </div>


    <!-- Tablo -->
    <div class="gfc-card">

        <div class="gfc-table-wrapper">

            <table class="gfc-table">

                <thead>
                    <tr>
                        <th>Dosya</th>
                        <th>Tür</th>
                        <th>Kaydeden</th>
                        <th>Kayıt Tarihi</th>
                        <th class="gfc-action-column">İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Dosya -->
                                <td>
                                    <div class="gfc-file-info">

                                        <div class="gfc-file-icon
                                            @(item.FileType == ".pdf" ? "gfc-pdf" :
                                              item.FileType == ".doc" || item.FileType == ".docx" ? "gfc-word" :
                                              item.FileType == ".xls" || item.FileType == ".xlsx" ? "gfc-excel" :
                                              "gfc-default")">

                                            @if (item.FileType == ".pdf")
                                            {
                                                <i class="fa-regular fa-file-pdf"></i>
                                            }
                                            else if (item.FileType == ".doc" || item.FileType == ".docx")
                                            {
                                                <i class="fa-regular fa-file-word"></i>
                                            }
                                            else if (item.FileType == ".xls" || item.FileType == ".xlsx")
                                            {
                                                <i class="fa-regular fa-file-excel"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-regular fa-file"></i>
                                            }

                                        </div>

                                        <div class="gfc-file-name">
                                            <strong>@item.Name</strong>

                                            <span>
                                                @item.FileType?.ToUpper()
                                            </span>
                                        </div>

                                    </div>
                                </td>


                                <!-- Tür -->
                                <td>
                                    <span class="gfc-type-badge">

                                        @if (item.FileType == ".pdf")
                                        {
                                            <i class="fa-regular fa-file-pdf"></i>
                                            <span>PDF</span>
                                        }
                                        else if (item.FileType == ".doc" || item.FileType == ".docx")
                                        {
                                            <i class="fa-regular fa-file-word"></i>
                                            <span>Word</span>
                                        }
                                        else if (item.FileType == ".xls" || item.FileType == ".xlsx")
                                        {
                                            <i class="fa-regular fa-file-excel"></i>
                                            <span>Excel</span>
                                        }
                                        else
                                        {
                                            <i class="fa-regular fa-file"></i>
                                            <span>Dosya</span>
                                        }

                                    </span>
                                </td>


                                <!-- Kaydeden -->
                                <td>
                                    <div class="gfc-user">

                                        <div class="gfc-user-icon">
                                            <i class="fa-solid fa-user"></i>
                                        </div>

                                        <span>
                                            @item.Created
                                        </span>

                                    </div>
                                </td>


                                <!-- Tarih -->
                                <td>
                                    <div class="gfc-date">
                                        <i class="fa-regular fa-calendar"></i>
                                        <span>
                                            @item.CreatedDate
                                        </span>
                                    </div>
                                </td>


                                <!-- İşlemler -->
                                <td>

                                    <div class="gfc-actions">

                                        <!-- İndir -->
                                        <a asp-action="Download"
                                           asp-route-id="@item.Id"
                                           class="gfc-action-btn gfc-download"
                                           title="Dosyayı indir">

                                            <i class="fa-solid fa-download"></i>
                                            <span>İndir</span>

                                        </a>


                                        <!-- Görüntüle -->
                                        @if (item.FileType == ".pdf")
                                        {
                                            <a href="@Url.Action("ViewPdf", "GuestFeeChart", new { id = item.Id })"
                                               target="_blank"
                                               class="gfc-action-btn gfc-view"
                                               title="PDF dosyasını görüntüle">

                                                <i class="fa-solid fa-eye"></i>
                                                <span>Görüntüle</span>

                                            </a>
                                        }


                                        <!-- Sil -->
                                        <button type="button"
                                                class="gfc-action-btn gfc-delete"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-file-id="@item.Id"
                                                data-file-name="@item.Name"
                                                title="Dosyayı sil">

                                            <i class="fa-solid fa-trash"></i>
                                            <span>Sil</span>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5">

                                <div class="gfc-empty">

                                    <div class="gfc-empty-icon">
                                        <i class="fa-solid fa-utensils"></i>
                                    </div>

                                    <h4>Henüz çizelge bulunmuyor</h4>

                                    <p>
                                        Sisteme henüz bir misafirhane yemek çizelgesi eklenmemiş.
                                    </p>

                                    <a asp-action="Create" class="gfc-empty-btn">
                                        <i class="fa-solid fa-plus"></i>
                                        İlk Çizelgeyi Ekle
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- ====================================================== -->
<!-- SİLME MODALI -->
<!-- ====================================================== -->

<div class="modal fade gfc-modal"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post" asp-action="Delete">

                <div class="modal-header">

                    <div class="gfc-modal-icon">
                        <i class="fa-solid fa-trash"></i>
                    </div>

                    <div>
                        <h5 class="modal-title" id="deleteModalLabel">
                            Çizelgeyi Sil
                        </h5>

                        <span>
                            Bu işlem geri alınamaz.
                        </span>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Kapat">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="gfc-delete-warning">

                        <i class="fa-solid fa-triangle-exclamation"></i>

                        <div>
                            <strong id="fileName"></strong>

                            <p>
                                adlı dosyayı silmek istediğinizden emin misiniz?
                            </p>
                        </div>

                    </div>

                    <input type="hidden" name="id" id="fileId" />

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="gfc-modal-cancel"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark"></i>
                        Vazgeç

                    </button>

                    <button type="submit"
                            class="gfc-modal-delete">

                        <i class="fa-solid fa-trash"></i>
                        Evet, Sil

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const deleteModal = document.getElementById("deleteModal");

            if (deleteModal) {

                deleteModal.addEventListener("show.bs.modal", function (event) {

                    const button = event.relatedTarget;

                    const fileId =
                        button.getAttribute("data-file-id");

                    const fileName =
                        button.getAttribute("data-file-name");

                    document.getElementById("fileId").value = fileId;

                    document.getElementById("fileName").textContent =
                        fileName;

                });

            }

        });

    </script>

}