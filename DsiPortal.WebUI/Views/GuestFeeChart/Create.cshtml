@model FoodListViewModel

@{
    ViewData["Title"] = "Misafirhane Yemek Çizelgesi Ekle";
}

<link rel="stylesheet" href="~/css/guest-fee-chart.css" asp-append-version="true" />


<div class="gfc-create-page">

    <!-- Başlık -->
    <div class="gfc-create-header">

        <div class="gfc-create-title">

            <a asp-action="Index" class="gfc-back-btn" title="Geri Dön">
                <i class="fa-solid fa-arrow-left"></i>
            </a>

            <div class="gfc-create-icon">
                <i class="fa-solid fa-utensils"></i>
            </div>

            <div>
                <h2>Misafirhane Yemek Çizelgesi Ekle</h2>

                <p>
                    Yeni yemek çizelgesini sisteme yükleyin.
                </p>
            </div>

        </div>

    </div>


    <!-- Form Kartı -->
    <div class="gfc-form-card">

        <form asp-action="Create"
              enctype="multipart/form-data"
              class="gfc-form">

            <div asp-validation-summary="ModelOnly"
                 class="gfc-validation-summary">
            </div>


            <!-- Dosya Adı -->
            <div class="gfc-form-group">

                <label asp-for="Name" class="gfc-label">

                    <i class="fa-solid fa-heading"></i>

                    Dosya Adı

                    <span>*</span>

                </label>

                <div class="gfc-input-wrapper">

                    <i class="fa-regular fa-file-lines"></i>

                    <input asp-for="Name"
                           class="gfc-input"
                           placeholder="Örn: Agustos_2026_Yemek_Cizelgesi"
                           autocomplete="off" />

                </div>

                <span asp-validation-for="Name"
                      class="gfc-validation">
                </span>


                <!-- Uyarı -->
                <div class="gfc-notice">

                    <div class="gfc-notice-icon">
                        <i class="fa-solid fa-circle-info"></i>
                    </div>

                    <div>

                        <strong>Dosya adı hakkında</strong>

                        <p>
                            PDF dosyalarında görüntüleme sorunu yaşamamak
                            için <strong>Adı</strong> alanında Türkçe karakter
                            kullanmamanız önerilir.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Dosya -->
            <div class="gfc-form-group">

                <label asp-for="File" class="gfc-label">

                    <i class="fa-solid fa-cloud-arrow-up"></i>

                    Dosya

                    <span>*</span>

                </label>


                <div class="gfc-upload-area" id="uploadArea">

                    <div class="gfc-upload-icon">

                        <i class="fa-solid fa-cloud-arrow-up"></i>

                    </div>

                    <h4>Dosyanızı seçin</h4>

                    <p>
                        Yüklemek için dosya seçiniz
                    </p>

                    <label for="customFile"
                           class="gfc-upload-btn">

                        <i class="fa-solid fa-folder-open"></i>

                        Dosya Seç

                    </label>

                    <input asp-for="File"
                           type="file"
                           id="customFile"
                           class="gfc-file-input"
                           accept=".pdf,.doc,.docx,.xls,.xlsx" />

                    <div class="gfc-selected-file"
                         id="selectedFile">

                        <i class="fa-regular fa-file"></i>

                        <span id="selectedFileName">
                            Dosya seçilmedi
                        </span>

                    </div>

                </div>

                <span asp-validation-for="File"
                      class="gfc-validation">
                </span>

            </div>


            <!-- Butonlar -->
            <div class="gfc-form-actions">

                <a asp-action="Index"
                   class="gfc-cancel-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Vazgeç

                </a>


                <button type="submit"
                        class="gfc-save-btn"
                        id="saveButton">

                    <i class="fa-solid fa-floppy-disk"></i>

                    Kaydet

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const fileInput =
                document.getElementById("customFile");

            const selectedFile =
                document.getElementById("selectedFile");

            const selectedFileName =
                document.getElementById("selectedFileName");

            const uploadArea =
                document.getElementById("uploadArea");

            const saveButton =
                document.getElementById("saveButton");


            /*
             * Dosya seçildiğinde
             */
            fileInput.addEventListener("change", function () {

                if (this.files && this.files.length > 0) {

                    const file =
                        this.files[0];

                    selectedFileName.textContent =
                        file.name;

                    selectedFile.classList.add("active");

                    uploadArea.classList.add("has-file");

                }
                else {

                    selectedFileName.textContent =
                        "Dosya seçilmedi";

                    selectedFile.classList.remove("active");

                    uploadArea.classList.remove("has-file");

                }

            });


            /*
             * Drag & Drop
             */

            uploadArea.addEventListener("dragover", function (e) {

                e.preventDefault();

                uploadArea.classList.add("dragging");

            });


            uploadArea.addEventListener("dragleave", function () {

                uploadArea.classList.remove("dragging");

            });


            uploadArea.addEventListener("drop", function (e) {

                e.preventDefault();

                uploadArea.classList.remove("dragging");

                if (e.dataTransfer.files.length > 0) {

                    fileInput.files =
                        e.dataTransfer.files;

                    fileInput.dispatchEvent(
                        new Event("change")
                    );

                }

            });


            /*
             * Form gönderilirken butonu kilitle
             */

            const form =
                document.querySelector(".gfc-form");

            form.addEventListener("submit", function () {

                if (saveButton) {

                    saveButton.disabled = true;

                    saveButton.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i> Kaydediliyor...';

                }

            });

        });

    </script>

}