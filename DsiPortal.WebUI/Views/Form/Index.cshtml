
@model IEnumerable<Forms>

@{
    ViewData["Title"] = "Formlar";
}

<link rel="stylesheet" href="~/css/forms.css" />

<div class="forms-page">

    <!-- HEADER -->
    <div class="forms-header">

        <div class="forms-header-left">

            <div class="forms-header-icon">
                <i class="fa-solid fa-file-lines"></i>
            </div>

            <div class="forms-header-text">

                <h2>Formlar</h2>

                <p>
                    Kurum içerisinde kullanılan formları yönetin.
                </p>

            </div>

        </div>


        <a asp-action="Create"
           class="btn btn-primary forms-add-button"
           title="Yeni Form Ekle">

            <i class="fa-solid fa-plus"></i>

            Yeni Form

        </a>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="forms-table-card">

            <div class="forms-table-wrapper">

                <table class="forms-table">

                    <thead>

                        <tr>

                            <th>Birim</th>

                            <th>Dosya</th>

                            <th>Tür</th>

                            <th>Kaydeden</th>

                            <th>Kayıt Tarihi</th>

                            <th class="text-end">İşlemler</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            string fileIcon = "fa-file";
                            string fileClass = "other";

                            if (item.FileType == ".pdf")
                            {
                                fileIcon = "fa-file-pdf";
                                fileClass = "pdf";
                            }
                            else if (item.FileType == ".doc" ||
                            item.FileType == ".docx")
                            {
                                fileIcon = "fa-file-word";
                                fileClass = "word";
                            }
                            else if (item.FileType == ".xls" ||
                            item.FileType == ".xlsx")
                            {
                                fileIcon = "fa-file-excel";
                                fileClass = "excel";
                            }

                            <tr>

                                <!-- BİRİM -->
                                <td data-label="Birim">

                                    <span class="forms-department">

                                        <i class="fa-solid fa-building"></i>

                                        @item.Department

                                    </span>

                                </td>


                                <!-- DOSYA -->
                                <td data-label="Dosya">

                                    <div class="forms-file">

                                        <div class="forms-file-icon @fileClass">

                                            <i class="fa-regular @fileIcon"></i>

                                        </div>


                                        <div class="forms-file-info">

                                            <span class="forms-file-name"
                                                  title="@item.Name">

                                                @item.Name

                                            </span>

                                            <span class="forms-file-type">

                                                @item.FileType

                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- TÜR -->
                                <td data-label="Tür">

                                    <span class="forms-type-badge">

                                        <i class="fa-regular @fileIcon"></i>

                                        @item.FileType.ToUpper()

                                    </span>

                                </td>


                                <!-- KAYDEDEN -->
                                <td data-label="Kaydeden">

                                    <div class="forms-meta">

                                        <div class="forms-meta-icon">

                                            <i class="fa-solid fa-user"></i>

                                        </div>

                                        <span class="forms-meta-text">

                                            @item.Created

                                        </span>

                                    </div>

                                </td>


                                <!-- TARİH -->
                                <td data-label="Kayıt Tarihi">

                                    <div class="forms-meta">

                                        <div class="forms-meta-icon">

                                            <i class="fa-regular fa-calendar"></i>

                                        </div>

                                        <span class="forms-meta-text">

                                            @item.CreatedDate

                                        </span>

                                    </div>

                                </td>


                                <!-- İŞLEMLER -->
                                <td data-label="İşlemler">

                                    <div class="forms-actions">

                                        <!-- DOWNLOAD -->

                                        <a asp-action="Download"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary forms-action-button"
                                           title="İndir">

                                            <i class="fa-solid fa-download"></i>

                                            <span>İndir</span>

                                        </a>


                                        <!-- PDF VIEW -->
                                        @if (item.FileType == ".pdf")
                                        {
                                            <a href="@Url.Action("ViewPdf", "Form", new { id = item.Id })"
                                               target="_blank"
                                               class="btn btn-outline-info forms-action-button"
                                               title="Görüntüle">

                                                <i class="fa-solid fa-eye"></i>

                                                <span>Görüntüle</span>

                                            </a>
                                        }


                                        <!-- DELETE -->

                                        <button type="button"
                                                class="btn btn-outline-danger forms-action-button"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-file-id="@item.Id"
                                                data-file-name="@item.Name"
                                                title="Sil">

                                            <i class="fa-solid fa-trash"></i>

                                            <span>Sil</span>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="forms-table-card">

            <div class="forms-empty">

                <div class="forms-empty-icon">

                    <i class="fa-solid fa-file-lines"></i>

                </div>

                <h5>
                    Henüz form bulunmuyor
                </h5>

                <p>
                    Sisteme henüz herhangi bir form eklenmemiş.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary rounded-pill px-4">

                    <i class="fa-solid fa-plus me-1"></i>

                    İlk Formu Ekle

                </a>

            </div>

        </div>
    }

</div>


<!-- =====================================================
     DELETE MODAL
     ===================================================== -->

<div class="modal fade forms-modal"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  asp-action="Delete">

                <div class="modal-body text-center p-4">

                    <div class="forms-delete-icon">

                        <i class="fa-solid fa-trash"></i>

                    </div>

                    <h5 class="fw-bold mb-2">

                        Formu Sil

                    </h5>

                    <p class="text-muted mb-0">

                        <span id="fileName"
                              class="forms-delete-name">
                        </span>

                        adlı form silinecek.

                    </p>

                    <input type="hidden"
                           name="id"
                           id="fileId" />

                </div>


                <div class="modal-footer border-0 justify-content-center pb-4">

                    <button type="button"
                            class="btn btn-light rounded-pill px-4"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark me-1"></i>

                        Vazgeç

                    </button>


                    <button type="submit"
                            class="btn btn-danger rounded-pill px-4">

                        <i class="fa-solid fa-trash me-1"></i>

                        Formu Sil

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const formsDeleteModal =
            document.getElementById('deleteModal');

        formsDeleteModal.addEventListener(
            'show.bs.modal',
            function (event) {

                const button =
                    event.relatedTarget;

                const fileId =
                    button.getAttribute('data-file-id');

                const fileName =
                    button.getAttribute('data-file-name');

                document.getElementById('fileId').value =
                    fileId;

                document.getElementById('fileName').textContent =
                    fileName;

            });

    </script>

}

