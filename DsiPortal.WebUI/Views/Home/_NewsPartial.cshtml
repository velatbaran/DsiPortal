@model List<WorksConducteds>

    <style>
    .news-img-wrapper {
        width: 100%;
        height: 130px;
        overflow: hidden;
    }

    .news-img {
        width: 100%;
        height: 100%;
        object-fit: cover; /* taşma yok */
        object-position: center;
        display: block; /* alt boşluk gider */
    }
</style>

@foreach (var item in Model)
{
    var slug = item.WorkingName
                    .ToLower()
                    .Replace(" ", "-")
                    .Replace("/", "-")
                    .Replace("ç", "c")
                    .Replace("ğ", "g")
                    .Replace("ı", "i")
                    .Replace("ö", "o")
                    .Replace("ş", "s")
                    .Replace("ü", "u");

                            <div class="d-flex align-items-center bg-white mb-2 news-item">
                                <div class="row w-100 m-0">
                                    <div class="col-lg-6 text-right">
                                        <a href="@Url.Action("NewsDetail", new { slug = slug })" title="@item.WorkingName">
                                            <div class="news-img-wrapper">
                                                <img src="@Url.Action("ViewImageNews", new { Id = item.Id })"
                                                     alt="@item.WorkingName"
                                                     class="news-img" />
                                            </div>
                                        </a>
                                    </div>
            <div class="col-lg-6 text-left">
                <span class="badge badge-primary font-weight-semi-bold p-1 mr-2">
                    @item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                </span><br />
                <a href=" @Url.Action("NewsDetail", new {  slug = slug })"
                   title="@item.WorkingName" style="color:black;font-size:14px">
                    @item.WorkingName
                </a>
            </div>
        </div>
    </div>
    <hr />
}