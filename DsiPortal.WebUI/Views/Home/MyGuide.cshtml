@model List<MyGuideDto>
@{
    ViewData["Title"] = "Telefon Rehberi";
    Layout = "_LayoutHomePage";
}

<link href="~/css/guide-theme.css" rel="stylesheet" />
<div class="guide-page-wrapper py-5">
    <div class="container">
        <!-- Sayfa Başlık Alanı -->
        <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
            <div>
                <h4 class="m-0 fw-bold text-uppercase text-dark">
                    <i class="fa-solid fa-address-book me-2 text-primary"></i>Kurum Rehberi
                </h4>
                <small class="text-muted">Tüm personel dahili ve cep telefonu iletişim bilgileri</small>
            </div>
            <span class="badge bg-primary text-uppercase text-dark rounded-pill px-3 py-2 fs-6">
                <i class="fa-solid fa-users me-1"></i> Toplam: @(Model?.Count ?? 0) Kişi
            </span>
        </div>

        <!-- Rehber Tablo Kartı -->
        <div class="guide-card p-4">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table id="myTable" class="table custom-table w-100">
                        <thead>
                            <tr>
                                <th>Ad Soyad</th>
                                <th>Unvan</th>
                                <th>Şube / Birim</th>
                                <th class="text-center">Dahili No</th>
                                <th>Cep Telefonu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle avatar-circle d-flex align-items-center justify-content-center me-2">
                                                @(string.IsNullOrEmpty(item.NameSurname) ? "?" : item.NameSurname.Substring(0, 1).ToUpper())
                                            </div>
                                            <span class="fw-bold text-dark">@item.NameSurname</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-secondary">@(string.IsNullOrEmpty(item.Title) ? "-" : item.Title)</span>
                                    </td>
                                    <td>
                                        <span class="badge department-badge px-2 py-1 fs-7">
                                            <i class="fa-regular fa-building me-1 text-muted"></i>
                                            @(string.IsNullOrEmpty(item.DepartmentName) ? "-" : item.DepartmentName)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.InternalNo))
                                        {
                                            <span class="internal-badge">
                                                <i class="fa-solid fa-phone-flip me-1 small"></i>@item.InternalNo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CepNo))
                                        {
                                            <a href="tel:@item.CepNo" class="phone-link">
                                                <i class="fa-solid fa-mobile-screen-button me-1 text-success"></i>@item.CepNo
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-address-card fs-1 text-muted mb-3"></i>
                    <h6 class="fw-bold text-secondary">Rehberde kayıtlı herhangi bir personel bulunamadı.</h6>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- FontAwesome (İkonlar için) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- DataTables JS & CSS -->
    <link href="~/datatable/datatables.min.css" rel="stylesheet" />
    <script src="~/admin/vendor/jquery/jquery.js"></script>
    <script src="~/datatable/datatables.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#myTable').DataTable({
                responsive: true,
                pageLength: 15,
                lengthMenu: [[10, 15, 25, 50, -1], [10, 15, 25, 50, "Tümü"]],
                language: {
                    url: '/datatable/tr.json'
                },
                dom: '<"d-flex flex-column flex-md-row justify-content-between align-items-center mb-3"lf>rt<"d-flex flex-column flex-md-row justify-content-between align-items-center mt-3"ip>',
                columnDefs: [
                    { orderable: false, targets: [3, 4] }
                ]
            });
        });
    </script>
}