@model List<DepartmentManagers>
@{
    ViewData["Title"] = "Yönetim Kadrosu";
    Layout = "_LayoutHomePage";
}

<link href="~/css/management-theme.css" rel="stylesheet" />

<div class="container py-5">
    <!-- Sayfa Başlığı ve İstatistik -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <h4 class="m-0 fw-bold text-uppercase text-dark">
            <i class="fa-solid fa-sitemap me-2 text-primary"></i>Yönetim Kadrosu
        </h4>
        <span class="badge bg-primary rounded-pill px-3 py-2">
            Toplam: @(Model?.Count ?? 0) Kayıt
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- 1. Düzey: Bölge Müdürü -->
        <div class="row justify-content-center mb-4">
            @foreach (var item in Model)
            {
                if (item.Titles?.Name == "Bölge Müdürü")
                {
                    var imgSrc = item.Image != null
                    ? Url.Action("ViewImageDepartmentManagers", new { Id = item.Id })
                    : Url.Content("~/homepage/img/user.png");

                    <div class="col-12 col-md-8 col-lg-5">
                        <div class="management-card text-center p-4 h-100 d-flex flex-column align-items-center justify-content-between">
                            <div class="w-100">
                                <div class="avatar-wrapper mb-3">
                                    <img src="@imgSrc" alt="@item.Name" />
                                </div>
                                <h5 class="fw-bold text-dark mb-1">@item.Name</h5>
                                <span class="badge bg-danger text-white mb-3 px-3 py-2 rounded-pill small fw-semibold">
                                    @item.Titles?.Name
                                </span>
                            </div>

                            <div class="w-100 border-top pt-3 mt-2 small text-muted">
                                @if (!string.IsNullOrEmpty(item.Eposta))
                                {
                                    <div class="mb-1 text-truncate">
                                        <i class="fa-regular fa-envelope me-1 text-secondary"></i>
                                        <a href="mailto:@item.Eposta" class="contact-link me-1">@item.Eposta</a>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(item.Phone))
                                {
                                    <div>
                                        <i class="fa-solid fa-phone me-1 text-secondary"></i>
                                        <span class="text-dark fw-medium">@item.Phone</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- 2. Düzey: Bölge Müdür Yardımcıları -->
        <div class="row justify-content-center g-4 mb-4">
            @foreach (var item in Model)
            {
                if (item.Titles?.Name == "Bölge Müdür Yardımcısı")
                {
                    var imgSrc = item.Image != null
                    ? Url.Action("ViewImageDepartmentManagers", new { Id = item.Id })
                    : Url.Content("~/homepage/img/user.png");

                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="management-card text-center p-3 h-100 d-flex flex-column align-items-center justify-content-between">
                            <div class="w-100">
                                <div class="avatar-wrapper mb-3">
                                    <img src="@imgSrc" alt="@item.Name" />
                                </div>
                                <h5 class="fw-bold text-dark mb-1 fs-6">@item.Name</h5>
                                <span class="badge bg-primary text-white mb-3 px-3 py-1 rounded-pill small fw-semibold">
                                    @item.Titles?.Name
                                </span>
                            </div>

                            <div class="w-100 border-top pt-3 mt-2 small text-muted">
                                @if (!string.IsNullOrEmpty(item.Eposta))
                                {
                                    <div class="mb-1 text-truncate">
                                        <i class="fa-regular fa-envelope me-1 text-secondary"></i>
                                        <a href="mailto:@item.Eposta" class="contact-link me-1">@item.Eposta</a>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(item.Phone))
                                {
                                    <div>
                                        <i class="fa-solid fa-phone me-1 text-secondary"></i>
                                        <span class="text-dark fw-medium">@item.Phone</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- 3. Düzey: Diğer Şube Müdürleri ve Yöneticiler -->
        <div class="row justify-content-center g-4 mb-4">
            @foreach (var item in Model)
            {
                if (item.Titles?.Name != null && !item.Titles.Name.Contains("Bölge Müdür") && !item.Titles.Name.Any(char.IsDigit))
                {
                    var imgSrc = item.Image != null
                    ? Url.Action("ViewImageDepartmentManagers", new { Id = item.Id })
                    : Url.Content("~/homepage/img/user.png");

                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="management-card text-center p-3 h-100 d-flex flex-column align-items-center justify-content-between">
                            <div class="w-100">
                                <div class="avatar-wrapper mb-3">
                                    <img src="@imgSrc" alt="@item.Name" />
                                </div>
                                <h5 class="fw-bold text-dark mb-1 fs-6">@item.Name</h5>
                                <span class="badge bg-light text-dark border mb-3 px-3 py-1 rounded-pill small fw-semibold">
                                    @item.Titles?.Name
                                </span>
                            </div>

                            <div class="w-100 border-top pt-3 mt-2 small text-muted">
                                @if (!string.IsNullOrEmpty(item.Eposta))
                                {
                                    <div class="mb-1 text-truncate">
                                        <i class="fa-regular fa-envelope me-1 text-secondary"></i>
                                        <a href="mailto:@item.Eposta" class="contact-link me-1">@item.Eposta</a>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(item.Phone))
                                {
                                    <div>
                                        <i class="fa-solid fa-phone me-1 text-secondary"></i>
                                        <span class="text-dark fw-medium">@item.Phone</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- 4. Düzey: Numaralı Şube Müdürlükleri -->
        if (Model.Any(x => x.Titles?.Name != null && x.Titles.Name.Any(char.IsDigit)))
        {
            <div class="section-divider">
                <span class="section-divider-title">
                    <i class="fa-solid fa-building-user me-2 text-secondary"></i>Numaralı Şube Müdürlükleri
                </span>
            </div>

            <div class="row justify-content-center g-4">
                @foreach (var item in Model)
                {
                    if (item.Titles?.Name != null && item.Titles.Name.Any(char.IsDigit))
                    {
                        var imgSrc = item.Image != null
                        ? Url.Action("ViewImageDepartmentManagers", new { Id = item.Id })
                        : Url.Content("~/homepage/img/user.png");

                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="management-card text-center p-3 h-100 d-flex flex-column align-items-center justify-content-between">
                                <div class="w-100">
                                    <div class="avatar-wrapper mb-3">
                                        <img src="@imgSrc" alt="@item.Name" />
                                    </div>
                                    <h5 class="fw-bold text-dark mb-1 fs-6">@item.Name</h5>
                                    <span class="badge bg-light text-dark border mb-3 px-3 py-1 rounded-pill small fw-semibold">
                                        @item.Titles?.Name
                                    </span>
                                </div>

                                <div class="w-100 border-top pt-3 mt-2 small text-muted">
                                    @if (!string.IsNullOrEmpty(item.Eposta))
                                    {
                                        <div class="mb-1 text-truncate">
                                            <i class="fa-regular fa-envelope me-1 text-secondary"></i>
                                            <a href="mailto:@item.Eposta" class="contact-link me-1">@item.Eposta</a>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Phone))
                                    {
                                        <div>
                                            <i class="fa-solid fa-phone me-1 text-secondary"></i>
                                            <span class="text-dark fw-medium">@item.Phone</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }
    else
    {
        <div class="alert alert-light border shadow-sm text-center py-4 my-5" role="alert">
            <i class="fa-solid fa-folder-open fs-2 mb-2 text-muted"></i>
            <h6 class="m-0 fw-bold text-secondary">Sistemde kayıtlı herhangi bir veri bulunamadı.</h6>
        </div>
    }
</div>