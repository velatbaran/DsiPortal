<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
    // Haritayı oluştur ve koordinatları merkezle
    var map = L.map('map').setView([40.60395, 43.09577], 17);

    // OpenStreetMap katmanı
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap Katkıda Bulunanlar'
    }).addTo(map);

    // Marker ekle ve popup ile isim göster
    L.marker([40.60395, 43.09577])
      .addTo(map)
      .bindPopup("<b>DSİ 24. Bölge Müdürlüğü</b>")
      .openPopup();
</script>
