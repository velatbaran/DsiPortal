@model AllViewModel
@{
    ViewData["Title"] = "Anasayfa";
    Layout = "_LayoutHomePage";
}

<link href="~/css/index-theme.css" rel="stylesheet" />
<link href="~/css/index-right-theme.css" rel="stylesheet" />


<div class="container-fluid">
    <div class="row">
        <div class="col-lg-9 px-0">
            <div class="owl-carousel main-carousel position-relative">
                @foreach (var item in Model.WorksConducteds.ToList())
                {
                    var slug = item.WorkingName
                    .ToLower()
                    .Replace(" ", "-")
                    .Replace("/", "-")
                    .Replace("ç", "c")
                    .Replace("ğ", "g")
                    .Replace("ı", "i")
                    .Replace("ö", "o")
                    .Replace("ş", "s")
                    .Replace("ü", "u");

                    <div class="position-relative overflow-hidden" style="height: 500px;">
                        <a class="h2 m-0 text-white text-uppercase font-weight-bold" href=" @Url.Action("NewsDetail", new {  slug = slug })" title="@item.WorkingName">
                            <img class="img-fluid h-100" src="@Url.Action("ViewImageNews", new {Id = item.Id  })" style="object-fit: cover;" title="@item.WorkingName" />
                        </a>
                        <div class="overlay">
                            <div class="mb-2">
                                <a class="text-white" href=" @Url.Action("NewsDetail", new {  slug = slug })">@item.CreatedDate</a>
                            </div>
                            <a class="h2 m-0 text-white text-uppercase font-weight-bold" href=" @Url.Action("NewsDetail", new {slug = slug })" title="@item.WorkingName">@item.WorkingName</a>
                        </div>
                    </div>
                }
            </div>

        </div>
        <div class="col-lg-3 px-0">
            <div class="manager-card position-relative overflow-hidden shadow-lg rounded-lg bg-white" style="height: 500px;">
                <div class="manager-img-wrapper h-100">
                    <img class="manager-img"
                         src="@Url.Action("ViewImageRegionalManager", new { Id = Model.RegionalManager.Id })"
                         alt="@Model.RegionalManager.Name">

                    <div class="manager-overlay d-flex flex-column justify-content-end p-4">
                        <!-- İsim -->
                        <h4 class="text-white font-weight-bold mb-1 manager-name">
                            @Model.RegionalManager.Name
                        </h4>

                        <!-- Unvan ve Ayraç Çizgisi -->
                        <div class="manager-title-wrapper d-flex align-items-center mt-1">
                            <span class="manager-divider"></span>
                            <p class="text-white-50 m-0 text-uppercase tracking-wider font-weight-semibold manager-title">
                                @Model.RegionalManager.Title
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid pt-5 mb-3">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="section-title">
                    <h4 class="m-0 text-uppercase font-weight-bold">Sosyal Tesis</h4>
                </div>
                <div class="row">
                    <div class="col-md-4 px-3 mt-2">
                        @if (Model.GuestFeeChart != null)
                        {
                            <div class="app-box social-box">
                                <img src="~/homepage/img/guest.png" width="70" height="70" alt="" />
                                @if (Model.GuestFeeChart.FileType == ".pdf")
                                {
                                    <a class="h6 m-0 text-center font-weight-bold" href="@Url.Action("ViewPdfGuestFeeChart", "Home", new { })" target="_blank">@Model.GuestFeeChart.Name</a>
                                }
                                else
                                {
                                    <a class="h6 m-0 text-center font-weight-bold" href="@Url.Action("DownloadGuestFeeChart", "Home", new { })" target="_blank">@Model.GuestFeeChart.Name</a>
                                }
                            </div>
                        }
                    </div>
                    <div class="col-md-4 px-3 mt-2">
                        @if (Model.GuestFeeChart != null)
                        {
                            <div class="app-box social-box">
                                <img src="~/homepage/img/food.png" width="70" height="70" alt="" />
                                @if (Model.FoodList != null)
                                {
                                    @if (Model.FoodList.FileType == ".pdf")
                                    {
                                        <a class="h6 m-0 text-center font-weight-bold" href="@Url.Action("ViewPdfFoodList", "Home", new { })" target="_blank">@Model.FoodList.Name</a>
                                    }
                                    else
                                    {
                                        <a class="h6 m-0 text-center font-weight-bold" href="@Url.Action("DownloadFoodList", "Home", new { })" target="_blank">@Model.FoodList.Name</a>
                                    }
                                }
                            </div>
                        }
                    </div>
                    <div class="col-md-4 px-3 mt-2">
                        @if (Model.FoodPriceList != null)
                        {
                            <div class="app-box social-box">
                                <img src="~/homepage/img/price.png" width="70" height="70" alt="" />
                                @if (Model.FoodPriceList.FileType == ".pdf")
                                {
                                    <a class="h6 m-0 text-center font-weight-bold" href="@Url.Action("ViewPdfFoodPriceList", "Home", new { })" target="_blank">@Model.GuestFeeChart.Name</a>
                                }
                                else
                                {
                                    <a class="h6 m-0 text-center font-weight-bold" href="@Url.Action("DownloadFoodPriceList", "Home", new { })" target="_blank">@Model.GuestFeeChart.Name</a>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="section-title mt-3">
                    <h4 class="m-0 text-uppercase font-weight-bold">Uygulamalar-Kısayollar</h4>
                </div>
                <div class="row">
                    @foreach (var item in Model.Apps.Skip(15))
                    {
                        <div class="col-md-4 px-3 mt-2">
                            <div class="app-box">
                                <a href="@item.Link" target="_blank" title="@item.Name">
                                    <img class="text-center"
                                         src="@Url.Action("ViewImageApps", new {Id = item.Id })"
                                         width="70" height="70" alt="">
                                </a>
                                <a class="h6 m-0 text-center font-weight-bold"
                                   href="@item.Link" target="_blank" title="@item.Name">
                                    @item.Name
                                </a>
                            </div>
                        </div>
                    }
                </div>


                <div class="section-title mt-3">
                    <h4 class="m-0 text-uppercase font-weight-bold">Faydalı Linkler</h4>
                </div>
                <div class="row">
                    @foreach (var item in Model.BenefitLinks.Skip(10))
                    {
                        <div class="col-md-4 px-3 mt-2">
                            <div class="app-box">
                                <a href="@item.Link" target="_blank" title="@item.Name">
                                    <img class="text-center" src="@Url.Action("ViewImageBnefitLinks", new {Id = item.Id  })" width="70" height="70" alt="">
                                </a>
                                <a class="h6 m-0 text-center font-weight-bold" href="@item.Link" target="_blank" title="@item.Name">@item.Name</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="mb-4">
                    <div class="section-title mb-2 d-flex align-items-center justify-content-between">
                        <span class="d-flex align-items-center">
                            <i class="fa-solid fa-bullhorn text-primary mr-2"></i>
                            <h4 class="m-0 text-uppercase font-weight-bold">Duyurular</h4>
                        </span>
                        <a class="news-see-all" href="/tumduyurular">Tümü <i class="fa-solid fa-arrow-right ml-1"></i></a>
                    </div>

                    <div class="announce-list-modern">
                        @foreach (var item in Model.Announcements)
                        {
                            string action = item.FileType == ".pdf" ? "ViewPdfAnnocumentn" : "DownloadAnnouncement";
                            string icon = item.FileType switch
                            {
                                ".pdf" => "fa-file-pdf",
                                ".docx" or ".docc" => "fa-file-word",
                                ".xlsx" or ".xls" => "fa-file-excel",
                                _ => "fa-file"
                            };
                            string iconColor = item.FileType switch
                            {
                                ".pdf" => "announce-icon-pdf",
                                ".docx" or ".docc" => "announce-icon-word",
                                ".xlsx" or ".xls" => "announce-icon-excel",
                                _ => ""
                            };

                            <a href="@Url.Action(action, "Home", new { id = item.Id })" target="_blank" title="@item.Name" class="announce-card">
                                <span class="announce-icon @iconColor">
                                    <i class="fa-regular @icon"></i>
                                </span>
                                <span class="announce-name">@item.Name</span>
                                <i class="fa-solid fa-arrow-up-right-from-square announce-ext"></i>
                            </a>
                        }
                    </div>
                </div>

                <div class="mb-4">

                    @if (Model.ListMenuOfDayViewModel.Eat5 != null || Model.ListMenuOfDayViewModel.Eat6 != null)
                    {
                        <div class="section-title mb-2 d-flex align-items-center">
                            <i class="fa-solid fa-moon text-warning mr-2"></i>
                            <h4 class="m-0 text-uppercase font-weight-bold">Günün Ramazan Menüsü</h4>
                        </div>
                        <div class="menu-card-dark">
                            @if (ViewData["FoodList"] != null)
                            {
                                <div class="menu-empty-dark">
                                    <i class="fa-solid fa-bowl-food"></i>
                                    <span>Güncel Ramazan menü yemek listesini yükleyin.</span>
                                </div>
                            }
                            <ul class="menu-list-dark list-unstyled m-0">
                                <li><i class="fa-solid fa-cookie-bite"></i><span>@Model.ListMenuOfDayViewModel.Eat1</span></li>
                                <li><i class="fa-solid fa-cookie-bite"></i><span>@Model.ListMenuOfDayViewModel.Eat2</span></li>
                                <li><i class="fa-solid fa-cookie-bite"></i><span>@Model.ListMenuOfDayViewModel.Eat3</span></li>
                                <li><i class="fa-solid fa-cookie-bite"></i><span>@Model.ListMenuOfDayViewModel.Eat4</span></li>
                                <li><i class="fa-solid fa-cookie-bite"></i><span>@Model.ListMenuOfDayViewModel.Eat5</span></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="section-title mb-2 d-flex align-items-center">
                            <i class="fa-solid fa-utensils text-primary mr-2"></i>
                            <h4 class="m-0 text-uppercase font-weight-bold">Günün Menüsü</h4>
                        </div>
                        <div class="menu-card-dark">
                            @if (ViewData["FoodList"] != null)
                            {
                                <div class="menu-empty-dark">
                                    <i class="fa-solid fa-bowl-food"></i>
                                    <span>Haftasonu ya da güncel yemek listesini yükleyin.</span>
                                </div>
                            }
                            <ul class="menu-list-dark list-unstyled m-0">
                                <li><i class="fa-solid fa-cookie-bite"></i><span>@Model.ListMenuOfDayViewModel.Eat1</span></li>
                                <li><i class="fa-solid fa-cookie-bite"></i><span>@Model.ListMenuOfDayViewModel.Eat2</span></li>
                                <li><i class="fa-solid fa-cookie-bite"></i><span>@Model.ListMenuOfDayViewModel.Eat3</span></li>
                                <li><i class="fa-solid fa-cookie-bite"></i><span>@Model.ListMenuOfDayViewModel.Eat4</span></li>
                            </ul>
                        </div>
                    }

                </div>

                <div class="mb-4">
                    <div class="section-title mb-2 d-flex align-items-center justify-content-between">
                        <span class="d-flex align-items-center">
                            <i class="fa-solid fa-clock-rotate-left text-primary mr-2"></i>
                            <h4 class="m-0 text-uppercase font-weight-bold">Geçmiş Haberler</h4>
                        </span>
                        <a class="news-see-all" href="/tumhaberler">Tümü <i class="fa-solid fa-arrow-right ml-1"></i></a>
                    </div>

                    <div class="news-list-modern">
                        @foreach (var item in Model.OldWorksConducteds)
                        {
                            var slug = item.WorkingName
                            .ToLower()
                            .Replace(" ", "-")
                            .Replace("/", "-")
                            .Replace("ç", "c")
                            .Replace("ğ", "g")
                            .Replace("ı", "i")
                            .Replace("ö", "o")
                            .Replace("ş", "s")
                            .Replace("ü", "u");

                            <a href="@Url.Action("NewsDetail", new { slug = slug })" title="@item.WorkingName" class="news-card-modern">
                                <div class="news-thumb">
                                    <img src="@Url.Action("ViewImageNews", new { Id = item.Id })" alt="@item.WorkingName" />
                                </div>
                                <div class="news-body">
                                    <span class="news-date-badge">@item.CreatedDate</span>
                                    <p class="news-title-modern">@item.WorkingName</p>
                                </div>
                                <i class="fa-solid fa-chevron-right news-chevron"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
