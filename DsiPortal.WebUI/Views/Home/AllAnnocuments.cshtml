@model List<Announcements>

@{
    ViewData["Title"] = "Tüm Duyurular";
    Layout = "_LayoutHomePage";
}

<style>
    :root {
        --brand-yellow: #ffc107;
        --brand-yellow-dark: #e0a800;
        --brand-yellow-light: #fff9e6;
        --brand-yellow-border: #ffe89a;
        --text-main: #212529;
        --text-muted: #6c757d;
        --bg-glass: rgba(255, 255, 255, 0.9);
        --border-glass: rgba(222, 226, 230, 0.8);
    }

    /* Modern Header (Orijinal Sarı Vurgulu) */
    .announcement-header {
        background: var(--bg-glass);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--border-glass);
        border-radius: 16px;
        padding: 1.5rem 1.75rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        margin-bottom: 1.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        /* Sol Sarı Şerit Vurgusu */
        .announcement-header::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 6px;
            background: var(--brand-yellow);
        }

    .header-title-group h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-main);
        letter-spacing: -0.02em;
        margin: 0 0 0.2rem 0;
    }

    .header-title-group p {
        color: var(--text-muted);
        font-size: 0.875rem;
        margin: 0;
    }

    .count-chip {
        background: var(--brand-yellow-light);
        border: 1px solid var(--brand-yellow-border);
        color: #856404;
        padding: 0.5rem 1.1rem;
        border-radius: 99px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* Duyuru Listesi Container */
    .announcement-list {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
    }

    /* Modern Duyuru Kartı & Hover Efektleri */
    .announcement-card {
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        padding: 1.1rem 1.35rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none !important;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.02);
        position: relative;
        overflow: hidden;
    }

        /* KART HOVER ÖZELLİĞİ */
        .announcement-card:hover {
            transform: translateY(-3px);
            border-color: var(--brand-yellow);
            box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.08), 0 0 0 1px var(--brand-yellow-border);
            background: #ffffff;
        }

    .card-left-content {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        flex: 1;
    }

    /* Dinamik Dosya İkon Kutusu */
    .file-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
        transition: transform 0.25s ease;
    }

    /* Hover Esnasında İkon Büyüme Efekti */
    .announcement-card:hover .file-icon-box {
        transform: scale(1.1);
    }

    /* Dosya Tiplerine Özel Renkler */
    .file-pdf {
        background: #fef2f2;
        color: #dc3545;
        border: 1px solid #fecaca;
    }

    .file-excel {
        background: #f0fdf4;
        color: #198754;
        border: 1px solid #bbf7d0;
    }

    .file-word {
        background: #eff6ff;
        color: #0d6efd;
        border: 1px solid #bfdbfe;
    }

    .file-default {
        background: #f8f9fa;
        color: #6c757d;
        border: 1px solid #dee2e6;
    }

    .announcement-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-main);
        margin: 0;
        line-height: 1.4;
        transition: color 0.2s ease;
    }

    /* Hover Esnasında Başlık Rengi Değişimi */
    .announcement-card:hover .announcement-title {
        color: #000000;
    }

    .card-right-content {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        flex-shrink: 0;
    }

    .date-badge {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

    /* Hover Esnasında Tarih Rozeti Vurgusu */
    .announcement-card:hover .date-badge {
        background: var(--brand-yellow-light);
        color: #856404;
        border-color: var(--brand-yellow-border);
    }

    .download-action {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #f8f9fa;
        color: var(--text-muted);
        border: 1px solid #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        transition: all 0.25s ease;
    }

    /* Hover Esnasında Sağdaki İndirme Düğmesinin Sarıya Dönüşmesi */
    .announcement-card:hover .download-action {
        background: var(--brand-yellow);
        color: #212529;
        border-color: var(--brand-yellow);
        transform: rotate(-45deg);
    }

    @@media (max-width: 640px) {
        .announcement-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.85rem;
            padding: 1.25rem;
        }

        .announcement-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.85rem;
        }

        .card-right-content {
            width: 100%;
            justify-content: space-between;
            border-top: 1px solid #f1f5f9;
            padding-top: 0.65rem;
        }
    }
</style>

<div class="container my-5 pt-3">
    <!-- Header -->
    <header class="announcement-header">
        <div class="header-title-group">
            <h1>Kurumsal Duyurular</h1>
            <p>Güncel duyuru, evrak ve bilgilendirme belgeleri.</p>
        </div>
        <div class="count-chip">
            <i class="fas fa-bullhorn"></i>
            <span>Toplam: <strong>@Model.Count</strong> Duyuru</span>
        </div>
    </header>

    <!-- Duyurular Listesi -->
    <main class="announcement-list">
        @foreach (var item in Model)
        {
            var ext = item.FileType?.ToLower();
            string actionName = ext == ".pdf" ? "ViewPdfAnnocumentn" : "DownloadAnnouncement";

            // Dosya uzantısına göre dinamik stil ve ikon seçimi
            string iconClass = "fa-file-alt";
            string styleClass = "file-default";

            if (ext == ".pdf")
            {
                iconClass = "fa-file-pdf";
                styleClass = "file-pdf";
            }
            else if (ext == ".xls" || ext == ".xlsx")
            {
                iconClass = "fa-file-excel";
                styleClass = "file-excel";
            }
            else if (ext == ".doc" || ext == ".docx")
            {
                iconClass = "fa-file-word";
                styleClass = "file-word";
            }

            <a href="@Url.Action(actionName, "Home", new { id = item.Id })"
               target="_blank"
               title="@item.Name"
               class="announcement-card">

                <div class="card-left-content">
                    <div class="file-icon-box @styleClass">
                        <i class="fa-regular @iconClass"></i>
                    </div>
                    <h2 class="announcement-title">@item.Name</h2>
                </div>

                <div class="card-right-content">
                    <span class="date-badge">
                        <i class="far fa-calendar-alt"></i>
                        @item.CreatedDate.ToString("dd.MM.yyyy")
                    </span>
                    <div class="download-action">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                </div>
            </a>
        }
    </main>
</div>