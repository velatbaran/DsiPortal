@model AnnocumentViewModel

@{
    ViewData["Title"] = "Organizasyon Şeması Ekle";
}

<link rel="stylesheet"
      href="~/css/managemention.css"
      asp-append-version="true" />

<div class="wc-header">
    <div class="wc-title">
        <i class="fa-solid fa-folder-plus"></i>
        Organizasyon Şeması Ekle
    </div>

    <a asp-action="Index" class="wc-back-link">
        <i class="fa-solid fa-arrow-left"></i>
        Geri Dön
    </a>
</div>


<div class="wc-card wc-form-card">

    <div class="wc-form-body">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>


            <!-- DOSYA ADI -->

            <div class="wc-form-group">

                <label asp-for="Name"></label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Dosya adını giriniz" />

                <div class="wc-info-note">
                    <i class="fa-solid fa-circle-info"></i>

                    <div>
                        <strong>PDF dosyaları için:</strong>
                        Görüntüleyicinin PDF dosyasını düzgün
                        görüntüleyebilmesi için <strong>Adı</strong>
                        alanında Türkçe karakter kullanmayınız.
                    </div>
                </div>
                <div class="wc-info-note">
                    <i class="fa-solid fa-circle-info"></i>
                    <div>
                        <strong>Sadece pdf ve resim dosyaları yükleyebilirsiniz.</strong>
                    </div>
                </div>
                <span asp-validation-for="Name"
                      class="text-danger"></span>

            </div>


            <!-- DOSYA -->

            <div class="wc-form-group">

                <label asp-for="File"></label>

                <div class="wc-file-wrapper">

                    <div class="custom-file">

                        <input asp-for="File"
                               class="custom-file-input"
                               id="customFile"
                               accept=".pdf,.doc,.docx,.xls,.xlsx,image/*" />

                        <label class="custom-file-label"
                               for="customFile">
                            Dosya seçiniz
                        </label>

                    </div>

                </div>

                <span asp-validation-for="File"
                      class="text-danger"></span>

            </div>


            <!-- KAYDET -->

            <div class="mt-4">

                <button type="submit"
                        class="btn wc-btn-save"
                        title="Kaydet">

                    <i class="fa-solid fa-floppy-disk"></i>

                    Kaydet

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $(".custom-file-input").on("change", function () {

            var fileName = $(this)
                .val()
                .split("\\")
                .pop();

            $(this)
                .siblings(".custom-file-label")
                .addClass("selected")
                .html(fileName || "Dosya seçiniz");

        });

    </script>
}