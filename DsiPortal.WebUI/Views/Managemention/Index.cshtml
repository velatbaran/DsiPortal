@model IEnumerable<Managemention>

@{
    ViewData["Title"] = "Yönetim";
}

<style>
    :root {
        --wc-primary: #4f46e5;
        --wc-primary-light: #eef2ff;
        --wc-radius: 14px;
        --wc-shadow: 0 4px 16px rgba(15, 23, 42, .06);
    }

    .wc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .wc-title {
        font-weight: 700;
        font-size: 1.5rem;
        color: #1e1b4b;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .wc-title .badge {
            font-size: .75rem;
            background: var(--wc-primary-light);
            color: var(--wc-primary);
            font-weight: 600;
        }

    .btn-wc-primary {
        background: var(--wc-primary);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: .55rem 1.1rem;
        font-weight: 600;
        transition: all .2s ease;
        box-shadow: 0 2px 8px rgba(79, 70, 229, .25);
    }

        .btn-wc-primary:hover {
            background: #4338ca;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(79, 70, 229, .35);
        }

    .wc-card {
        background: #fff;
        border-radius: var(--wc-radius);
        box-shadow: var(--wc-shadow);
        border: 1px solid #eef0f4;
        overflow: hidden;
    }

    .wc-toolbar {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #f0f1f5;
        background: #fafbff;
    }

    .wc-search-wrap .input-group-text {
        background: #fff;
        border-right: none;
        color: #94a3b8;
    }

    .wc-search-wrap input {
        border-left: none;
    }

        .wc-search-wrap input:focus {
            box-shadow: none;
            border-color: #dfe3ea;
        }

    table.wc-table {
        margin-bottom: 0;
    }

        table.wc-table thead th {
            background: #f8f9fc;
            color: #64748b;
            font-size: .8rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-weight: 700;
            border-bottom: 1px solid #eef0f4;
            padding: .9rem 1rem;
            white-space: nowrap;
        }

        table.wc-table tbody tr.wc-row {
            transition: background .15s ease;
        }

            table.wc-table tbody tr.wc-row:hover {
                background: #f9fafe;
            }

        table.wc-table tbody td {
            padding: .85rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f2f3f7;
        }

    .wc-name {
        font-weight: 600;
        color: #1e293b;
    }

    .wc-file-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .3rem .65rem;
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 600;
    }

        .wc-file-badge.word {
            background: #eaf2ff;
            color: #2563eb;
        }

        .wc-file-badge.pdf {
            background: #fee2e2;
            color: #dc2626;
        }

        .wc-file-badge.excel {
            background: #e7f7ee;
            color: #16a34a;
        }

        .wc-file-badge.image {
            background: #f3e8ff;
            color: #9333ea;
        }

    .wc-actions {
        display: flex;
        gap: .4rem;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .btn-action {
        border-radius: 9px;
        font-weight: 600;
        font-size: .8rem;
        padding: .4rem .7rem;
        border: none;
        transition: all .15s ease;
    }

        .btn-action.btn-download {
            background: var(--wc-primary-light);
            color: var(--wc-primary);
        }

            .btn-action.btn-download:hover {
                background: var(--wc-primary);
                color: #fff;
            }

        .btn-action.btn-view {
            background: #e0f2fe;
            color: #0284c7;
        }

            .btn-action.btn-view:hover {
                background: #0284c7;
                color: #fff;
            }

    .btn-icon-sm {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        border: 1px solid #f1d3d3;
        background: #fff5f5;
        color: #e11d48;
        transition: all .15s ease;
        flex-shrink: 0;
    }

        .btn-icon-sm:hover {
            background: #e11d48;
            color: #fff;
        }

    .wc-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: #94a3b8;
    }

    #deleteModal .modal-content {
        border: none;
        border-radius: 16px;
        overflow: hidden;
    }

    #deleteModal .modal-header {
        background: #fff5f5;
        border-bottom: none;
    }

    #deleteModal .modal-title {
        color: #be123c;
        font-weight: 700;
    }
</style>

<div class="wc-header">
    <div class="wc-title">
        <i class="fa-solid fa-folder-tree" style="color:var(--wc-primary)"></i>
        Yönetim
        <span class="badge">@Model.Count() dosya</span>
    </div>
    <a asp-action="Create" class="btn btn-wc-primary" title="Yeni Yönetim Ekle">
        <i class="fa-solid fa-plus"></i> Yeni Yönetim Ekle
    </a>
</div>

<div class="wc-card">
    <div class="wc-toolbar">
        <div class="input-group wc-search-wrap" style="max-width: 340px;">
            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="wcSearch" class="form-control" placeholder="Dosyalarda ara...">
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="wc-empty">
            <i class="fa-solid fa-folder-open fa-2x mb-2"></i>
            <div>Henüz kayıt bulunmuyor.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table wc-table" id="myTable">
                <thead>
                    <tr>
                        <th>Dosya Adı</th>
                        <th>Tür</th>
                        <th>Kaydeden</th>
                        <th>Kayıt Tarihi</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string badgeClass;
                        string iconClass;
                        string typeLabel;

                        switch (item.FileType)
                        {
                            case ".docx":
                            case ".doc":
                                badgeClass = "word";
                                iconClass = "fa-regular fa-file-word";
                                typeLabel = "Word";
                                break;
                            case ".pdf":
                                badgeClass = "pdf";
                                iconClass = "fa-regular fa-file-pdf";
                                typeLabel = "PDF";
                                break;
                            case ".xlsx":
                            case ".xls":
                                badgeClass = "excel";
                                iconClass = "fa-regular fa-file-excel";
                                typeLabel = "Excel";
                                break;
                            default:
                                badgeClass = "image";
                                iconClass = "fa-solid fa-image";
                                typeLabel = "Görsel";
                                break;
                        }

                        <tr class="wc-row" data-search="@item.Name.ToLower()">
                            <td><span class="wc-name">@item.Name</span></td>
                            <td>
                                <span class="wc-file-badge @badgeClass">
                                    <i class="@iconClass"></i> @typeLabel
                                </span>
                            </td>
                            <td>@item.Created</td>
                            <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="wc-actions">
                                    <a asp-action="Download" asp-route-id="@item.Id" class="btn-action btn-download" title="İndir">
                                        <i class="fa-solid fa-download"></i> İndir
                                    </a>
                                    @if (item.FileType == ".pdf")
                                    {
                                        <a href="@Url.Action("ViewPdf", "Managemention", new { id = item.Id })" target="_blank" class="btn-action btn-view">
                                            <i class="fa-solid fa-eye"></i> Görüntüle
                                        </a>
                                    }
                                    <button type="button" class="btn-icon-sm" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-file-id="@item.Id" data-file-name="@item.Name" title="Sil">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="Delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel"><i class="fa-solid fa-triangle-exclamation me-2"></i>Silme Onayı</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <strong id="fileName"></strong> kaydını silmek istediğinize emin misiniz?
                    <input type="hidden" name="id" id="fileId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" title="İptal"><i class="fa-solid fa-xmark"></i> İptal</button>
                    <button type="submit" class="btn btn-danger" title="Sil"><i class="fa-solid fa-trash"></i> Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const deleteModal = document.getElementById('deleteModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const fileId = button.getAttribute('data-file-id');
        const fileName = button.getAttribute('data-file-name');

        document.getElementById('fileId').value = fileId;
        document.getElementById('fileName').textContent = fileName;
    });

    document.addEventListener('DOMContentLoaded', function () {
        var searchInput = document.getElementById('wcSearch');
        if (searchInput) {
            searchInput.addEventListener('keyup', function () {
                var term = this.value.trim().toLowerCase();
                document.querySelectorAll('#myTable tbody tr.wc-row').forEach(function (row) {
                    var haystack = row.getAttribute('data-search') || '';
                    row.style.display = haystack.includes(term) ? '' : 'none';
                });
            });
        }
    });
</script>
