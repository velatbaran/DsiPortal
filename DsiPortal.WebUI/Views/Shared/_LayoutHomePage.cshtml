@using System.Web
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var yotube = "https://www.youtube.com/@DSI24.BOLGEMUDURLUGU";
    var beta = "https://sosyal.teknofest.app/@dsi24bolgekars";
    var apps = ViewBag.Apps as List<Apps>;
    var benefitLinks = ViewBag.BenefitLinks as List<BenefitLinks>;
    var cameras = ViewBag.Cameras as List<Cameras>;
    var organizaitonchart = ViewBag.OrganizationalChart as Managemention;
    var userAgent = HttpContextAccessor.HttpContext.Request.Headers["User-Agent"].ToString();
    bool isEdge = userAgent.Contains("Edg");
}
<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - DSİ 24.Bölge Müdürlüğü Portal</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="DSİ 24.Bölge Portal" name="dsi,kars,dsi24">

    <!-- Favicon -->
    <link href="/homepage/img/dsi24.png" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="~/lib/fontawesome/css/all.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <!-- Libraries Stylesheet -->
    <link href="~/homepage/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/homepage/css/style.css?v=2.2" rel="stylesheet">
    <link href="~/css/layout-homapage-theme.css" rel="stylesheet" />

</head>

<body>

    <!-- ===== Identity / top bar ===== -->
    <div class="dsi-topbar">
        <div class="container-fluid">
            <div class="row align-items-center py-2 gy-2">
                <div class="col-md-1"></div>
                <div class="col-md-4 d-flex flex-wrap align-items-center">
                    <a href="https://www.tccb.gov.tr/" class="logo-link" title="Türkiye Cumhuriyeti Cumhurbaşkanlığı" target="_blank">
                        <img src="~/homepage/img/yuzyil.png" width="70" height="70" alt="Cumhurbaşkanlığı" />
                    </a>
                    <a href="https://www.tarimorman.gov.tr/" class="logo-link" target="_blank" title="Tarım ve Orman Bakanlığı">
                        <img src="~/homepage/img/tarim-logo.png" width="70" height="70" alt="Tarım ve Orman Bakanlığı" />
                    </a>
                    <a href="https://www.dsi.gov.tr/" class="logo-link" target="_blank" title="Devlet Su İşleri Genel Müdürlüğü">
                        <img src="~/homepage/img/dsi.png" width="140" height="70" alt="DSİ Genel Müdürlüğü" />
                    </a>
                    <a href="https://dsiteknikbulteni.dsi.gov.tr/" class="logo-link" target="_blank" title="Devlet Su İşleri Teknik Bülteni">
                        <img src="~/homepage/img/dsiteknik.png" width="70" height="70" alt="DSİ Teknik Bülteni" />
                    </a>
                </div>
                <div class="col-md-4">
                    <div class="dsi-title-block">
                        <p class="eyebrow">Devlet Su İşleri</p>
                        <p class="title-main">DEVLET SU İŞLERİ GENEL MÜDÜRLÜĞÜ</p>
                        <p class="title-sub">24. Bölge Müdürlüğü</p>
                    </div>
                </div>
                <div class="col-md-2 d-flex flex-wrap align-items-center">
                    <a href="https://bolge24.dsi.gov.tr/" class="logo-link" target="_blank" title="Devlet Su İşleri 24.Bölge Müdürlüğü">
                        <img src="~/homepage/img/dsi24.png" width="140" height="70" alt="DSİ 24. Bölge Müdürlüğü" />
                    </a>
                    <a href="https://www.kars.bel.tr/serhat-sehri-kars" class="logo-link" target="_blank" title="Kars Kalesi Tarihçesi">
                        <img src="~/homepage/img/kale.jpg" width="70" height="70" alt="Kars Kalesi" style="border-radius:8px" />
                    </a>
                </div>
                <div class="col-md-1"></div>
            </div>
        </div>
        <span class="dsi-wave-divider"></span>
    </div>

    <!-- ===== Quick-access apps ribbon ===== -->
    <div class="apps-ribbon-wrap">
        <div class="container-fluid">
            <div id="apps-viewport" class="position-relative overflow-hidden">
                <div id="apps-track">
                    @foreach (var item in apps)
                    {
                        <div class="app-item text-center">
                            <a href="@item.Link" target="_blank">
                                <img src="@Url.Action("ViewImageApps", new { Id = item.Id })"
                                     alt="@item.Name" title="@item.Name" />
                            </a>
                            <div class="app-name">
                                <a class="text-secondary" href="@item.Link"
                                   target="_blank" title="@item.Name">@item.Name</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Navbar Start -->
    <div class="container-fluid p-0">
        <nav class="navbar navbar-expand-lg dsi-navbar navbar-dark py-1 px-lg-5">
            <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between px-0 px-lg-3" id="navbarCollapse">
                <div class="navbar-nav mr-auto py-0">
                    <a href="/anasayfa" class="nav-item nav-link active"><i class="fa-solid fa-house"></i>Anasayfa</a>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-solid fa-circle-info"></i>Hakkımızda</a>
                        <div class="dropdown-menu rounded-0 m-0">
                            <a href="/yonetim" class="dropdown-item"><i class="fa-solid fa-people-roof"></i> Yönetim</a>
                            @if (organizaitonchart.FileType == ".pdf")
                            {
                                <a href="@Url.Action("ViewPdfOrganizationalChart", "Home", new { })" target="_blank" class="dropdown-item">
                                    <i class="fa-solid fa-street-view"></i> Organizasyon Şeması
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("ViewImageOrganizationalChart", "Home", new { })" target="_blank" class="dropdown-item">
                                    <i class="fa-solid fa-street-view"></i> Organizasyon Şeması
                                </a>
                            }
                            <a href="/tarihcemiz" class="dropdown-item"><i class="fa-solid fa-landmark"></i> Tarihçemiz</a>
                        </div>
                    </div>
                    <a href="http://10.124.4.110:8088/widea" class="nav-item nav-link" target="_blank"><i class="fa-solid fa-phone-volume"></i>Karel</a>
                    <a href="http://10.124.5.83/index.asp" class="nav-item nav-link" target="_blank"><i class="fa-solid fa-fingerprint"></i>Meyer(PDKS)</a>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-solid fa-file-signature"></i>DHYS</a>
                        <div class="dropdown-menu rounded-0 m-0">
                            <a href="https://yenidhys.dsi.gov.tr/" class="dropdown-item" target="_blank"><i class="fa-solid fa-handshake-angle"></i> Yeni DHYS</a>
                            <a href="https://dhys.dsi.gov.tr/DsiPersonel/" class="dropdown-item" target="_blank"><i class="fa-solid fa-handshake-angle"></i> Eski DHYS</a>
                        </div>
                    </div>
                    <a href="/formlar" class="nav-item nav-link"><i class="fa-solid fa-file-lines"></i>Formlar</a>
                    <a href="/rehberimiz" class="nav-item nav-link"><i class="fa-solid fa-book"></i>Rehberimiz</a>

                    <!-- Faydalı Linkler -->
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-solid fa-link"></i>Faydalı Linkler</a>
                        <div class="dropdown-menu rounded-0 m-0 benefit-links-panel">
                            <div class="benefit-grid">
                                @foreach (var item in benefitLinks)
                                {
                                    <a href="@item.Link" target="_blank" class="benefit-item" title="@item.Name">
                                        <img src="@Url.Action("ViewImageBnefitLinks", new { Id = item.Id })" alt="@item.Name" />
                                        <span>@item.Name</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    @if (cameras.Count() != 0)
                    {
                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-solid fa-video"></i>Kameralar</a>
                            <div class="dropdown-menu rounded-0 m-0">
                                @foreach (var item in cameras)
                                {
                                    var url = item.Link?.Trim();
                                    var finalUrl = isEdge ? url : "microsoft-edge:" + url;

                                    <a href="@finalUrl" class="dropdown-item" target="_blank">
                                        <i class="fa-solid fa-camera"></i> @item.Name
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <a href="/iletisim" class="nav-item nav-link"><i class="fa-solid fa-address-card"></i>İletişim</a>
                </div>
                <div class="navbar-nav ml-auto py-0">
                    <a href="/Account/Index" class="nav-item nav-link" target="_blank"><i class="fa-solid fa-user-shield"></i>Admin Paneli</a>
                    <a href="http://172.20.124.11:81/" class="nav-item nav-link" target="_blank"><i class="fa-solid fa-server"></i>Bt Yönetimi</a>
                </div>
            </div>
        </nav>
    </div>
    <!-- Navbar End -->
    @RenderBody()

    <!-- Footer Start -->
    <div class="container-fluid dsi-footer pt-5 px-sm-3 px-md-5 mt-5">
        <div class="row py-4">
            <div class="col-lg-3 col-md-6 mb-5">
                <h5 class="mb-4 text-uppercase font-weight-bold">DSİ 24.Bölge Müdürlüğü</h5>
                <p class="font-weight-medium"><i class="fa fa-map-marker-alt mr-2"></i>Örnek mah. Hastane sok. Merkez/Kars</p>
                <p class="font-weight-medium"><i class="fa fa-phone-alt mr-2"></i>0474 212 5804 - 5806</p>
                <p class="font-weight-medium"><i class="fa-solid fa-fax mr-2"></i>0474 212 5811 (Fax)</p>
                <p class="font-weight-medium"><i class="fa fa-envelope mr-2"></i>dsi24@dsi.gov.tr</p>
                <p class="font-weight-medium"><i class="fa-solid fa-paper-plane mr-2"></i>dsi.gnlmud@hs01.kep.tr (Kep Adresi)</p>
                <p class="font-weight-medium"><i class="fa-solid fa-arrow-down-1-9 mr-2"></i>394 003 9126 (Vergi Numarası)</p>
            </div>
            <div class="col-lg-5 col-md-6 mb-5">
                <h5 class="mb-4 text-uppercase font-weight-bold">Taşra Şubelerimiz</h5>
                <div class="row g-3">
                    <div class="col-lg-4 mb-3 mb-lg-0">
                        <div class="branch-card">
                            <p class="font-weight-medium mb-3">241.Şube Müdürlüğü</p>
                            <p class="mb-1 small"><i class="fa fa-phone-alt mr-2"></i>Telefon</p>
                            <p class="mb-3">0474 223 5334</p>
                            <p class="mb-1 small"><i class="fa fa-fax mr-2"></i>Fax</p>
                            <p class="mb-0">0474 212 5811</p>
                        </div>
                    </div>
                    <div class="col-lg-4 mb-3 mb-lg-0">
                        <div class="branch-card">
                            <p class="font-weight-medium mb-3">242.Şube Müdürlüğü</p>
                            <p class="mb-1 small"><i class="fa fa-phone-alt mr-2"></i>Telefon</p>
                            <p class="mb-3">0476 227 6710</p>
                            <p class="mb-1 small"><i class="fa fa-fax mr-2"></i>Fax</p>
                            <p class="mb-0">0476 227 6710</p>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="branch-card">
                            <p class="font-weight-medium mb-3">243.Şube Müdürlüğü</p>
                            <p class="mb-1 small"><i class="fa fa-phone-alt mr-2"></i>Telefon</p>
                            <p class="mb-3">0478 211 5855</p>
                            <p class="mb-1 small"><i class="fa fa-fax mr-2"></i>Fax</p>
                            <p class="mb-0">0478 211 5805</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 mb-5">
                <h5 class="mb-4 text-uppercase font-weight-bold">Sosyal Tesis</h5>
                <div class="branch-card">
                    <p class="font-weight-medium mb-3">Sosyal Tesis-Misafirhane</p>
                    <p class="mb-1 small"><i class="fa fa-phone-alt mr-2"></i>Telefon</p>
                    <p class="mb-3">0474 223 5720</p>
                    <p class="mb-1 small"><i class="fa fa-phone-alt mr-2"></i>Dahili No</p>
                    <p class="mb-0">1450</p>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 mb-5">
                <h6 class="mt-4 mb-3 text-uppercase font-weight-bold">Bizi Takip Edin</h6>
                <div class="d-flex justify-content-start flex-wrap gap-2">
                    <a class="btn btn-lg btn-lg-square mr-2 mb-2" href="https://x.com/dsi_24_blgmd/" target="_blank" title="Twitter"><i class="fab fa-twitter"></i></a>
                    <a class="btn btn-lg btn-lg-square mr-2 mb-2" href="https://www.facebook.com/karsdsi" target="_blank" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a class="btn btn-lg btn-lg-square mr-2 mb-2" href="https://www.instagram.com/dsi24.bolgemudurlugu/" target="_blank" title="Instagram"><i class="fab fa-instagram"></i></a>
                    <a class="btn btn-lg btn-lg-square mr-2 mb-2" href="@yotube" target="_blank" title="Youtube"><i class="fab fa-youtube"></i></a>
                    <a class="btn btn-lg btn-lg-square mb-2" href="@beta" target="_blank" title="Sosyal Teknofest"><i class="fa-solid fa-umbrella-beach"></i></a>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid dsi-copyright py-4 px-sm-3 px-md-5">
        <p class="m-0 text-center text-white">
            &copy; @DateTime.Now.Year Tüm Hakları Saklıdır. <br />
            Bilgi Teknolojileri Şube Müdürlüğü tarafından tasarlandı.<br>
        </p>
    </div>
    <!-- Footer End -->
    <!-- Back to Top -->
    <a href="#" class="btn btn-primary btn-square back-to-top"><i class="fa fa-arrow-up"></i></a>

    <!-- JavaScript Libraries -->
    <script src="~/admin/vendor/jquery/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/fontawesome/js/all.js"></script>
    <script src="~/lib/fontawesome/js/all.min.js"></script>
    <script src="~/homepage/lib/easing/easing.min.js"></script>
    <script src="~/homepage/lib/owlcarousel/owl.carousel.min.js"></script>
    <!-- Template Javascript -->
    <script src="~/homepage/js/main.js"></script>
    @RenderSection("Scripts", false)
</body>

</html>