@model IEnumerable<WorksConducteds>

@{
    ViewData["Title"] = "Yapılan Haberler";
}

<style>
    :root {
        --wc-primary: #4f46e5;
        --wc-primary-light: #eef2ff;
        --wc-radius: 14px;
        --wc-shadow: 0 4px 16px rgba(15, 23, 42, .06);
    }

    .wc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .wc-title {
        font-weight: 700;
        font-size: 1.5rem;
        color: #1e1b4b;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .wc-title .badge {
            font-size: .75rem;
            background: var(--wc-primary-light);
            color: var(--wc-primary);
            font-weight: 600;
        }

    .btn-wc-primary {
        background: var(--wc-primary);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: .55rem 1.1rem;
        font-weight: 600;
        transition: all .2s ease;
        box-shadow: 0 2px 8px rgba(79, 70, 229, .25);
    }

        .btn-wc-primary:hover {
            background: #4338ca;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(79, 70, 229, .35);
        }

    .wc-card {
        background: #fff;
        border-radius: var(--wc-radius);
        box-shadow: var(--wc-shadow);
        border: 1px solid #eef0f4;
        overflow: hidden;
    }

    .wc-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #f0f1f5;
        background: #fafbff;
    }

    .wc-search-wrap .input-group-text {
        background: #fff;
        border-right: none;
        color: #94a3b8;
    }

    .wc-search-wrap input {
        border-left: none;
    }

        .wc-search-wrap input:focus {
            box-shadow: none;
            border-color: #dfe3ea;
        }

    .btn-bulk-danger {
        border-radius: 10px;
        font-weight: 600;
        padding: .5rem 1rem;
        border: 1px solid #f1d3d3;
        background: #fff5f5;
        color: #e11d48;
        transition: all .15s ease;
    }

        .btn-bulk-danger:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        .btn-bulk-danger:not(:disabled):hover {
            background: #e11d48;
            color: #fff;
        }

    table.wc-table {
        margin-bottom: 0;
    }

        table.wc-table thead th {
            background: #f8f9fc;
            color: #64748b;
            font-size: .8rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-weight: 700;
            border-bottom: 1px solid #eef0f4;
            padding: .9rem 1rem;
            white-space: nowrap;
        }

        table.wc-table tbody tr.wc-row {
            transition: background .15s ease;
        }

            table.wc-table tbody tr.wc-row:hover {
                background: #f9fafe;
            }

        table.wc-table tbody tr.wc-row-selected {
            background: var(--wc-primary-light);
        }

        table.wc-table tbody td {
            padding: .85rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f2f3f7;
        }

    .form-check-input {
        cursor: pointer;
    }

    .wc-thumb {
        width: 46px;
        height: 46px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #eef0f4;
    }

    .wc-name {
        font-weight: 600;
        color: #1e293b;
    }

    .btn-icon-sm {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        border: 1px solid #f1d3d3;
        background: #fff5f5;
        color: #e11d48;
        transition: all .15s ease;
    }

        .btn-icon-sm:hover {
            background: #e11d48;
            color: #fff;
        }

    .wc-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: #94a3b8;
    }

    #deleteModal .modal-content,
    #bulkDeleteModal .modal-content {
        border: none;
        border-radius: 16px;
        overflow: hidden;
    }

    #deleteModal .modal-header,
    #bulkDeleteModal .modal-header {
        background: #fff5f5;
        border-bottom: none;
    }

    #deleteModal .modal-title,
    #bulkDeleteModal .modal-title {
        color: #be123c;
        font-weight: 700;
    }

    /* Toastr - modern görünüm için ince özelleştirme */
    #toast-container > div {
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .15);
        opacity: 1;
    }

    #toast-container > .toast-success {
        background-color: #16a34a;
    }

    #toast-container > .toast-error {
        background-color: #dc2626;
    }

    #toast-container > .toast-warning {
        background-color: #d97706;
    }

    #toast-container > .toast-info {
        background-color: #4f46e5;
    }
</style>

<div class="wc-header">
    <div class="wc-title">
        <i class="fa-solid fa-newspaper" style="color:var(--wc-primary)"></i>
        Toplam Haber Sayısı
        <span class="badge">@ViewBag.TotalCount</span>
    </div>
    <a asp-action="Create" class="btn btn-wc-primary" title="Yeni Çalışma Ekle">
        <i class="fa-solid fa-plus"></i> Yeni Çalışma Ekle
    </a>
</div>

<form id="bulkDeleteForm" method="post" asp-action="DeleteSelected">
    <div class="wc-card">
        <div class="wc-toolbar">
            <div class="input-group wc-search-wrap" style="max-width: 340px;">
                <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" id="wcSearch" class="form-control" placeholder="Haberlerde ara...">
            </div>

            <button type="button" id="bulkDeleteBtn" class="btn btn-bulk-danger" disabled
                    data-bs-toggle="modal" data-bs-target="#bulkDeleteModal">
                <i class="fa-solid fa-trash"></i>
                Seçilenleri Sil (<span id="selectedCount">0</span>)
            </button>
        </div>

        @if (!Model.Any())
        {
            <div class="wc-empty">
                <i class="fa-solid fa-inbox fa-2x mb-2"></i>
                <div>Henüz kayıt bulunmuyor.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table wc-table" id="myTable">
                    <thead>
                        <tr>
                            <th style="width:40px;">
                                <input type="checkbox" class="form-check-input" id="selectAll">
                            </th>
                            <th>Adı</th>
                            <th>Resim</th>
                            <th>Kaydeden</th>
                            <th>Kayıt Tarihi</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="wc-row" data-search="@item.WorkingName.ToLower()">
                                <td>
                                    <input type="checkbox" class="form-check-input row-check" name="ids" value="@item.Id">
                                </td>
                                <td><span class="wc-name">@item.WorkingName</span></td>
                                <td>
                                    <img src="@Url.Action("ViewImage", new { id = item.Id })" class="wc-thumb" alt="@item.WorkingName">
                                </td>
                                <td>@item.Created</td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">
                                    <button type="button" class="btn-icon-sm" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-file-id="@item.Id" data-file-name="@item.WorkingName" title="Sil">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</form>

<!-- Tekli Silme Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="Delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel"><i class="fa-solid fa-triangle-exclamation me-2"></i>Silme Onayı</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <strong id="fileName"></strong> kaydını silmek istediğinize emin misiniz?
                    <input type="hidden" name="id" id="fileId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa-solid fa-xmark"></i> İptal</button>
                    <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Çoklu Silme Onay Modal -->
<div class="modal fade" id="bulkDeleteModal" tabindex="-1" aria-labelledby="bulkDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkDeleteModalLabel"><i class="fa-solid fa-triangle-exclamation me-2"></i>Toplu Silme Onayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Seçtiğiniz <strong><span id="bulkSelectedCount">0</span></strong> kaydı silmek istediğinize emin misiniz?
                Bu işlem geri alınamaz.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa-solid fa-xmark"></i> İptal</button>
                <button type="button" id="confirmBulkDelete" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Evet, Sil</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('wcSearch');
            var selectAll = document.getElementById('selectAll');
            var rowChecks = document.querySelectorAll('.row-check');
            var bulkDeleteBtn = document.getElementById('bulkDeleteBtn');
            var selectedCountEl = document.getElementById('selectedCount');
            var bulkSelectedCountEl = document.getElementById('bulkSelectedCount');

            function updateSelectionState() {
                var checkedCount = document.querySelectorAll('.row-check:checked').length;
                selectedCountEl.textContent = checkedCount;
                bulkSelectedCountEl.textContent = checkedCount;
                bulkDeleteBtn.disabled = checkedCount === 0;

                rowChecks.forEach(function (cb) {
                    cb.closest('tr').classList.toggle('wc-row-selected', cb.checked);
                });

                if (selectAll) {
                    var visibleChecks = Array.from(rowChecks).filter(function (cb) {
                        return cb.closest('tr').style.display !== 'none';
                    });
                    var allVisibleChecked = visibleChecks.length > 0 && visibleChecks.every(function (cb) { return cb.checked; });
                    selectAll.checked = allVisibleChecked;
                }
            }

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    rowChecks.forEach(function (cb) {
                        if (cb.closest('tr').style.display !== 'none') {
                            cb.checked = selectAll.checked;
                        }
                    });
                    updateSelectionState();
                });
            }

            rowChecks.forEach(function (cb) {
                cb.addEventListener('change', updateSelectionState);
            });

            if (searchInput) {
                searchInput.addEventListener('keyup', function () {
                    var term = this.value.trim().toLowerCase();
                    document.querySelectorAll('#myTable tbody tr.wc-row').forEach(function (row) {
                        var haystack = row.getAttribute('data-search') || '';
                        row.style.display = haystack.includes(term) ? '' : 'none';
                    });
                    updateSelectionState();
                });
            }

            document.getElementById('confirmBulkDelete').addEventListener('click', function () {
                document.getElementById('bulkDeleteForm').submit();
            });

            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var fileId = button.getAttribute('data-file-id');
                var fileName = button.getAttribute('data-file-name');

                document.getElementById('fileId').value = fileId;
                document.getElementById('fileName').textContent = fileName;
            });

        });
    </script>
}
