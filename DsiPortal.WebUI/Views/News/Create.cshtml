@model WorksConductedViewModel

@{
    ViewData["Title"] = "Haber Ekle";
}

<link rel="stylesheet"
      href="~/css/news.css"
      asp-append-version="true" />

<div class="wc-header">
    <div class="wc-title">
        <i class="fa-solid fa-newspaper"></i>
        Haber Ekle
    </div>

    <a asp-action="Index" class="wc-back-link">
        <i class="fa-solid fa-arrow-left"></i>
        Geri Dön
    </a>
</div>

<div class="wc-card wc-form-card">

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data"
          id="uploadForm">

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <!-- Haber Başlığı -->
        <div class="wc-form-group">

            <label asp-for="WorkingName" class="control-label"></label>

            <textarea asp-for="WorkingName"
                      class="form-control"
                      rows="2"
                      placeholder="Haber başlığını giriniz"></textarea>

            <span asp-validation-for="WorkingName"
                  class="text-danger"></span>

        </div>


        <!-- Açıklama -->
        <div class="wc-form-group">

            <label for="Description">
                Açıklama
            </label>

            <textarea id="Description"
                      name="Description"
                      class="form-control">@(Model?.Description ?? "")</textarea>

        </div>


        <!-- Resimler -->
        <div class="wc-form-group">

            <label asp-for="ImageFiles"
                   class="control-label">
            </label>

            <div class="custom-file">

                <input asp-for="ImageFiles"
                       class="custom-file-input"
                       id="customFile"
                       multiple
                       accept="image/*">

                <label class="custom-file-label"
                       for="customFile">
                    Resim seçiniz (çoklu seçim yapabilirsiniz)
                </label>

            </div>

            <span asp-validation-for="ImageFiles"
                  class="text-danger">
            </span>

            <small class="form-text text-muted">
                Birden fazla resim seçmek için CTRL tuşuna basılı tutarak tıklayın.
            </small>

        </div>


        <!-- Kaydet -->
        <div class="wc-form-group mb-0">

            <button type="submit"
                    class="btn wc-btn-save"
                    title="Kaydet">

                <i class="fa-solid fa-floppy-disk"></i>
                Kaydet

            </button>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        // Çoklu dosya seçimi
        $('.custom-file-input').on('change', function () {

            var files = $(this)[0].files;
            var fileNames = [];

            for (var i = 0; i < files.length; i++) {
                fileNames.push(files[i].name);
            }

            var label = $(this).next('.custom-file-label');

            if (files.length > 1) {

                label.html(
                    files.length +
                    ' dosya seçildi: ' +
                    fileNames.join(', ')
                );

            }
            else if (files.length === 1) {

                label.html(fileNames[0]);

            }
            else {

                label.html(
                    'Resim seçiniz (çoklu seçim yapabilirsiniz)'
                );

            }

        });

    </script>


    <!-- CKEditor -->
    <script src="~/ckeditor_4.22.1_standard/ckeditor/ckeditor.js"></script>

    <script>

        CKEDITOR.replace('Description', {

            height: 300,

            allowedContent:
                'p b i u; strong em; br;',

            removePlugins:
                'sourcearea',

            pasteFilter:
                'p b i u; strong em; br;',

            on: {

                paste: function (evt) {

                    var editorData =
                        evt.data.dataValue;

                    // Gereksiz boş paragrafları temizle
                    editorData =
                        editorData.replace(
                            /(<p>(&nbsp;|\s)*<\/p>)+/gi,
                            '<p></p>'
                        );

                    // Tekrarlayan boşlukları azalt
                    editorData =
                        editorData.replace(
                            /\s{2,}/g,
                            ' '
                        );

                    evt.data.dataValue =
                        editorData;
                }

            }

        });

    </script>
}