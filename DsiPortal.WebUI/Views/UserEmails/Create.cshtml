
@model UserEmailViewModel

@{
    ViewData["Title"] = "Eposta Ekle";
}

<link rel="stylesheet" href="~/css/user-emails.css" />

<div class="ue-page">

    <!-- Sayfa Başlığı -->
    <div class="ue-header">

        <div class="ue-header-left">

            <div class="ue-title-icon">
                <i class="fa-solid fa-envelope-circle-check"></i>
            </div>

            <div>
                <h2>Yeni Eposta Ekle</h2>
                <p>Sisteme yeni bir kullanıcı eposta adresi ekleyin.</p>
            </div>

        </div>

        <a asp-action="Index" class="ue-back-btn">
            <i class="fa-solid fa-arrow-left"></i>
            Eposta Listesine Dön
        </a>

    </div>


    <!-- Form -->
    <div class="ue-form-wrapper">

        <div class="ue-form-card">

            <div class="ue-form-header">

                <div class="ue-form-icon">
                    <i class="fa-solid fa-envelope"></i>
                </div>

                <div>
                    <h4>Eposta Bilgileri</h4>
                    <span>
                        Kullanıcı eposta adresini giriniz.
                    </span>
                </div>

            </div>


            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger ue-validation-summary">
                </div>


                <div class="ue-form-group">

                    <label asp-for="Eposta">
                        <i class="fa-solid fa-at"></i>
                        Eposta Adresi
                    </label>

                    <div class="ue-input-wrapper">

                        <i class="fa-solid fa-envelope"></i>

                        <input asp-for="Eposta"
                               class="ue-input"
                               type="email"
                               placeholder="ornek@dsi.gov.tr"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="Eposta"
                          class="text-danger ue-validation">
                    </span>

                </div>


                <div class="ue-form-info">

                    <i class="fa-solid fa-circle-info"></i>

                    <span>
                        Lütfen geçerli bir eposta adresi giriniz.
                    </span>

                </div>


                <div class="ue-form-buttons">

                    <a asp-action="Index"
                       class="ue-cancel-btn">

                        <i class="fa-solid fa-xmark"></i>
                        İptal

                    </a>


                    <button type="submit"
                            class="ue-save-btn">

                        <i class="fa-solid fa-floppy-disk"></i>
                        Kaydet

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

