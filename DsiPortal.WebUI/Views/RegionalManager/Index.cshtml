
@model IEnumerable<RegionalManagers>

@{
    ViewData["Title"] = "Bölge Müdürü";
}

<link href="~/css/relational-manager-theme.css" rel="stylesheet" />

<div class="manager-page">

    <!-- Header -->
    <div class="manager-header">

        <div class="manager-title">
            <div class="manager-title-icon">
                <i class="fa-solid fa-user-tie"></i>
            </div>

            <div>
                <h2>Bölge Müdürü</h2>
                <p>Bölge müdürü bilgilerini ve kayıtlarını yönetin.</p>
            </div>
        </div>

        <a asp-action="Create"
           class="btn btn-primary add-manager-btn">
            <i class="fa-solid fa-plus"></i>
            Yeni Bölge Müdürü
        </a>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-xl-4 col-lg-6 col-md-6">

                    <div class="manager-card">

                        <!-- Cover -->
                        <div class="manager-cover">

                            <div class="manager-avatar-wrapper">
                                <img src="@Url.Action("ViewImage", new { id = item.Id })"
                                     class="manager-avatar"
                                     alt="@item.Name"
                                     loading="lazy" />
                            </div>

                        </div>


                        <!-- Content -->
                        <div class="manager-content">

                            <div class="manager-name">
                                @item.Name
                            </div>

                            <div class="manager-title-badge">
                                <i class="fa-solid fa-briefcase"></i>
                                @item.Title
                            </div>


                            <div class="manager-info">

                                <div class="info-item">
                                    <span class="info-label">
                                        <i class="fa-solid fa-user"></i>
                                        KAYDEDEN
                                    </span>

                                    <span class="info-value">
                                        @item.Created
                                    </span>
                                </div>


                                <div class="info-item">
                                    <span class="info-label">
                                        <i class="fa-regular fa-calendar"></i>
                                        KAYIT TARİHİ
                                    </span>

                                    <span class="info-value">
                                        @item.CreatedDate
                                    </span>
                                </div>

                            </div>


                            <!-- Actions -->
                            <div class="manager-actions">

                                <button type="button"
                                        class="btn btn-outline-danger manager-action"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-file-id="@item.Id"
                                        data-file-name="@item.Name">

                                    <i class="fa-solid fa-trash"></i>
                                    Sil

                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- Empty -->
        <div class="empty-state">

            <div class="empty-icon">
                <i class="fa-solid fa-user-tie"></i>
            </div>

            <h5 class="fw-bold">
                Bölge Müdürü Kaydı Bulunamadı
            </h5>

            <p class="text-muted mb-4">
                Sistemde henüz bir bölge müdürü kaydı bulunmuyor.
            </p>

            <a asp-action="Create"
               class="btn btn-primary rounded-pill px-4">

                <i class="fa-solid fa-plus me-1"></i>
                İlk Kaydı Oluştur

            </a>

        </div>
    }

</div>

<!-- DELETE MODAL -->
<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post" asp-action="Delete">

                <div class="modal-body text-center p-4">

                    <div class="delete-icon">
                        <i class="fa-solid fa-trash"></i>
                    </div>

                    <h5 class="fw-bold mb-2">
                        Bölge Müdürünü Sil
                    </h5>

                    <p class="text-muted mb-0">

                        <strong id="fileName"></strong>
                        adlı bölge müdürü kaydı silinecek.

                    </p>

                    <input type="hidden"
                           name="id"
                           id="fileId" />

                </div>


                <div class="modal-footer border-0 justify-content-center pb-4">

                    <button type="button"
                            class="btn btn-light px-4 rounded-pill"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark"></i>
                        Vazgeç

                    </button>

                    <button type="submit"
                            class="btn btn-danger px-4 rounded-pill">

                        <i class="fa-solid fa-trash"></i>
                        Kaydı Sil

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const deleteModal =
            document.getElementById('deleteModal');

        deleteModal.addEventListener(
            'show.bs.modal',
            function (event) {

                const button = event.relatedTarget;

                const fileId =
                    button.getAttribute('data-file-id');

                const fileName =
                    button.getAttribute('data-file-name');

                document.getElementById('fileId').value =
                    fileId;

                document.getElementById('fileName').textContent =
                    fileName;

            });

    </script>

}
