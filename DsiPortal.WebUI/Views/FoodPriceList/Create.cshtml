@model FoodListViewModel

@{
    ViewData["Title"] = "Yemek Fiyat Listesi Ekle";
}

<link href="~/css/foodpricelist.css" rel="stylesheet" />

<div class="food-page">

    <!-- PAGE HEADER -->

    <div class="food-page-header">

        <div class="food-title-area">

            <div class="food-title-icon">
                <i class="fa-solid fa-utensils"></i>
            </div>

            <div>
                <h2>Yemek Fiyat Listesi Ekle</h2>

                <p>
                    Sisteme yeni bir yemek fiyat listesi yükleyin.
                </p>
            </div>

        </div>


        <a asp-action="Index"
           class="food-back-btn">

            <i class="fa-solid fa-arrow-left"></i>
            Geri Dön

        </a>

    </div>


    <!-- FORM CARD -->

    <div class="food-form-card">

        <div class="food-form-header">

            <div class="food-form-icon">
                <i class="fa-solid fa-file-circle-plus"></i>
            </div>

            <div>

                <h4>
                    Yeni Fiyat Listesi
                </h4>

                <span>
                    Fiyat listesi bilgilerini ve dosyayı giriniz.
                </span>

            </div>

        </div>


        <form asp-action="Create"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="food-validation-summary">
            </div>


            <!-- DOSYA ADI -->

            <div class="food-form-group">

                <label asp-for="Name">

                    <i class="fa-solid fa-file-signature"></i>
                    Dosya Adı

                </label>


                <input asp-for="Name"
                       class="food-input"
                       placeholder="Dosya adını giriniz" />


                <div class="food-warning">

                    <i class="fa-solid fa-triangle-exclamation"></i>

                    <div>

                        <strong>Önemli:</strong>

                        Sadece PDF dosyaları için geçerlidir.
                        Görüntü sağlayıcısının PDF dosyalarını
                        düzgün görüntüleyebilmesi için
                        <strong>Dosya Adı</strong> alanında
                        Türkçe karakter kullanmayınız.

                    </div>

                </div>


                <span asp-validation-for="Name"
                      class="food-validation">
                </span>

            </div>


            <!-- DOSYA -->

            <div class="food-form-group">

                <label asp-for="File">

                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    Dosya

                </label>


                <input asp-for="File"
                       class="food-file-input"
                       id="customFile"
                       accept=".pdf,.doc,.docx,.xls,.xlsx" />


                <span asp-validation-for="File"
                      class="food-validation">
                </span>

            </div>


            <!-- FOOTER -->

            <div class="food-form-footer">

                <a asp-action="Index"
                   class="food-cancel-btn">

                    <i class="fa-solid fa-xmark"></i>
                    İptal

                </a>


                <button type="submit"
                        class="food-save-btn">

                    <i class="fa-solid fa-floppy-disk"></i>
                    Kaydet

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    <script>

        document
            .getElementById("customFile")
            .addEventListener("change", function () {

                if (this.files.length > 0) {

                    console.log(
                        "Seçilen dosya:",
                        this.files[0].name
                    );

                }

            });

    </script>

}