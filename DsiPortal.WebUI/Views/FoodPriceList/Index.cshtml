@model IEnumerable<FoodPriceList>

@{
    ViewData["Title"] = "Yemek Fiyat Listesi";
}

<link href="~/css/foodpricelist.css" rel="stylesheet" />
<div class="food-page">

    <!-- PAGE HEADER -->
    <div class="food-page-header">

        <div class="food-title-area">

            <div class="food-title-icon">
                <i class="fa-solid fa-utensils"></i>
            </div>

            <div>
                <h2>Yemek Fiyat Listesi</h2>
                <p>Yemek fiyat listelerini buradan yönetebilirsiniz.</p>
            </div>

        </div>

        <a asp-action="Create" class="food-add-btn">
            <i class="fa-solid fa-plus"></i>
            Yeni Fiyat Listesi Ekle
        </a>

    </div>


    <!-- CARD -->
    <div class="food-card">

        <div class="food-card-header">

            <div>
                <h5>
                    <i class="fa-solid fa-file-lines"></i>
                    Fiyat Listeleri
                </h5>

                <span>
                    Sistemde kayıtlı yemek fiyat listeleri
                </span>
            </div>

            <div class="food-count">
                <i class="fa-solid fa-layer-group"></i>
                @Model.Count() Kayıt
            </div>

        </div>


        <!-- TABLE -->
        <div class="food-table-wrapper">

            <table class="food-table">

                <thead>
                    <tr>
                        <th>Dosya Adı</th>
                        <th>Tür</th>
                        <th>Kaydeden</th>
                        <th>Kayıt Tarihi</th>
                        <th style="text-align:center;">İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- DOSYA ADI -->
                            <td>

                                <div class="food-file-name">

                                    <div class="food-file-icon">

                                        @if (item.FileType == ".pdf")
                                        {
                                            <i class="fa-regular fa-file-pdf"></i>
                                        }
                                        else if (item.FileType == ".doc" || item.FileType == ".docx")
                                        {
                                            <i class="fa-regular fa-file-word"></i>
                                        }
                                        else if (item.FileType == ".xls" || item.FileType == ".xlsx")
                                        {
                                            <i class="fa-regular fa-file-excel"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-regular fa-file"></i>
                                        }

                                    </div>

                                    <span>
                                        @item.Name
                                    </span>

                                </div>

                            </td>


                            <!-- TÜR -->
                            <td>

                                <span class="food-file-type">

                                    @if (item.FileType == ".pdf")
                                    {
                                        <i class="fa-regular fa-file-pdf"></i>
                                    }
                                    else if (item.FileType == ".doc" || item.FileType == ".docx")
                                    {
                                        <i class="fa-regular fa-file-word"></i>
                                    }
                                    else if (item.FileType == ".xls" || item.FileType == ".xlsx")
                                    {
                                        <i class="fa-regular fa-file-excel"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-file"></i>
                                    }

                                </span>

                            </td>


                            <!-- KAYDEDEN -->
                            <td>

                                <span class="food-created">
                                    <i class="fa-solid fa-user"></i>
                                    @item.Created
                                </span>

                            </td>


                            <!-- TARİH -->
                            <td>

                                <span class="food-date">
                                    @item.CreatedDate
                                </span>

                            </td>


                            <!-- İŞLEMLER -->
                            <td>

                                <div class="food-actions">

                                    <a asp-action="Download"
                                       asp-route-id="@item.Id"
                                       class="food-action-btn food-download-btn"
                                       title="Dosyayı İndir">

                                        <i class="fa-solid fa-download"></i>
                                        İndir

                                    </a>


                                    @if (item.FileType == ".pdf")
                                    {
                                        <a href="@Url.Action("ViewPdf", "FoodPriceList", new { id = item.Id })"
                                           target="_blank"
                                           class="food-action-btn food-view-btn"
                                           title="PDF Görüntüle">

                                            <i class="fa-solid fa-eye"></i>
                                            Görüntüle

                                        </a>
                                    }


                                    <button type="button"
                                            class="food-action-btn food-delete-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-file-id="@item.Id"
                                            data-file-name="@item.Name"
                                            title="Sil">

                                        <i class="fa-solid fa-trash"></i>
                                        Sil

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- DELETE MODAL -->

<div class="modal fade food-delete-modal"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post" asp-action="Delete">

                <div class="food-modal-header">

                    <div class="food-modal-icon">
                        <i class="fa-solid fa-trash"></i>
                    </div>

                    <div>
                        <h5 id="deleteModalLabel">
                            Silme Onayı
                        </h5>
                    </div>

                </div>


                <div class="food-modal-body">

                    <div class="food-delete-warning">

                        <i class="fa-solid fa-triangle-exclamation"></i>

                        <div>

                            <strong id="fileName"></strong>

                            <p>
                                Bu dosyayı silmek istediğinize emin misiniz?
                                Bu işlem geri alınamaz.
                            </p>

                        </div>

                    </div>

                    <input type="hidden"
                           name="id"
                           id="fileId" />

                </div>


                <div class="food-modal-footer">

                    <button type="button"
                            class="food-modal-cancel"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark"></i>
                        İptal

                    </button>


                    <button type="submit"
                            class="food-modal-delete">

                        <i class="fa-solid fa-trash"></i>
                        Sil

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const deleteModal =
            document.getElementById('deleteModal');

        deleteModal.addEventListener(
            'show.bs.modal',
            function (event) {

                const button =
                    event.relatedTarget;

                const fileId =
                    button.getAttribute('data-file-id');

                const fileName =
                    button.getAttribute('data-file-name');

                document.getElementById('fileId').value =
                    fileId;

                document.getElementById('fileName').textContent =
                    fileName;

            });

    </script>

}